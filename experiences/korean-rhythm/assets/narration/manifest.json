      "completeDecode": true
    },
    {
      "id": "t1q1v0",
      "text": "이 가방은 비싸지만 오래 쓸 수 있어요. 가격은 비싸도 오래 쓸 수 있나요?",
      "url": "assets/narration/t1q1v0.mp3",
