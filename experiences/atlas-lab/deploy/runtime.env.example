# systemd EnvironmentFile format; not a shell script.
# Copy outside the checkout to /etc/synk-dating/runtime.env, owned by root (0600).
NODE_ENV=production
SYNK_DATING_MODE=account
SYNK_DATING_PORT=4302
SYNK_DATING_DB=/var/lib/synk-dating/account.sqlite
SYNK_DATING_ACCOUNT_CONFIG=/etc/synk-dating/account.public.json
SYNK_DATING_PUBLIC_ORIGIN=https://dating.example.invalid
SYNK_DATING_TRUSTED_PROXIES=127.0.0.1

# Configure only after the corresponding real integration is ready.
# No tokens, operators, or paid provider are enabled by this template.
# SYNK_DATING_LIFECYCLE_TOKEN=
# SYNK_DATING_OPERATORS=
# SYNK_DATING_ADULT_ADAPTER=/etc/synk-dating/adult-adapter.mjs

# Restore evidence is deliberately absent from normal startup.
# Restored databases require the explicit --check-restore / --resume-after-restore flow.
