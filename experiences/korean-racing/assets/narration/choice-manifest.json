      "rms": 1175
    },
    {
      "id": "c10q2o2",
      "text": "날짜",
      "duration": 1.668,
      "bytes": 10604,
      "rms": 1475
    },
    {
      "id": "c10q3o0",
      "text": "이용할 수 없어요",
      "duration": 2.205,
      "bytes": 13772,
      "rms": 1612
    },
    {
      "id": "c10q3o1",
      "text": "오후 7시까지 가능해요",
      "duration": 2.915,
      "bytes": 18092,
      "rms": 1794
    },
    {
      "id": "c10q3o2",
      "text": "오전만 가능해요",
      "duration": 2.394,
      "bytes": 14924,
      "rms": 1744
    },
    {
      "id": "c10q4o0",
      "text": "검은 우산",
      "duration": 1.887,
      "bytes": 11900,
      "rms": 1625
    },
    {
      "id": "c10q4o1",
      "text": "검은 가방",
      "duration": 2.007,
      "bytes": 12620,
      "rms": 1627
    },
    {
      "id": "c10q4o2",
      "text": "흰 우산",
      "duration": 1.88,
      "bytes": 11900,
      "rms": 1457
    },
    {
      "id": "c10q5o0",
      "text": "돈을 내지 않아요",
      "duration": 2.618,
      "bytes": 16364,
      "rms": 1691
    },
    {
      "id": "c10q5o1",
      "text": "1층에서 만나요",
