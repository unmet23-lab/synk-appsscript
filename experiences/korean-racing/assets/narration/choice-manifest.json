      "rms": 1142
    },
    {
      "id": "c10q2o2",
      "text": "날짜",
      "duration": 1.647,
      "bytes": 10460,
      "rms": 1423
    },
    {
      "id": "c10q3o0",
      "text": "이용할 수 없어요",
      "duration": 2.069,
      "bytes": 13052,
      "rms": 1667
    },
    {
      "id": "c10q3o1",
      "text": "오후 7시까지 가능해요",
      "duration": 2.812,
      "bytes": 17516,
      "rms": 1878
    },
    {
      "id": "c10q3o2",
      "text": "오전만 가능해요",
      "duration": 2.221,
      "bytes": 13916,
      "rms": 1609
    },
    {
      "id": "c10q4o0",
      "text": "검은 우산",
