      "rms": 1403
    },
    {
      "id": "c11q4o0",
      "text": "은행",
      "duration": 1.477,
      "bytes": 9452,
      "rms": 1119
    },
    {
      "id": "c11q4o1",
      "text": "집",
      "duration": 1.337,
      "bytes": 8588,
      "rms": 1005
    },
    {
      "id": "c11q4o2",
      "text": "학교",
      "duration": 1.556,
      "bytes": 9884,
      "rms": 1527
    },
    {
      "id": "c11q5o0",
      "text": "동생은 매운 음식을 못 먹어요",
      "duration": 3.476,
      "bytes": 21404,
      "rms": 1843
    },
    {
      "id": "c11q5o1",
      "text": "둘 다 매운 음식을 좋아해요",
      "duration": 3.4,
      "bytes": 20972,
      "rms": 1856
    },
    {
      "id": "c11q5o2",
      "text": "저는 매운 음식을 못 먹어요",
      "duration": 3.302,
      "bytes": 20396,
      "rms": 1890
    },
    {
      "id": "c12q1o0",
      "text": "무료로 들어가요",
      "duration": 2.233,
      "bytes": 14060,
      "rms": 1799
    },
    {
      "id": "c12q1o1",
      "text": "돈을 내야 해요",
      "duration": 2.316,
      "bytes": 14492,
      "rms": 1677
    },
    {
      "id": "c12q1o2",
      "text": "문이 닫혀 있어요",
      "duration": 2.228,
      "bytes": 13916,
      "rms": 1566
    },
    {
      "id": "c12q2o0",
      "text": "9시 30분",
      "duration": 2.286,
      "bytes": 14348,
      "rms": 1802
    },
    {
      "id": "c12q2o1",
      "text": "9시 20분",
      "duration": 2.211,
      "bytes": 13916,
      "rms": 1608
    },
    {
      "id": "c12q2o2",
      "text": "9시 40분",
      "duration": 2.316,
      "bytes": 14492,
      "rms": 1628
    },
    {
      "id": "c12q3o0",
      "text": "받을 수 있어요",
      "duration": 2.209,
      "bytes": 13916,
      "rms": 1695
    },
    {
      "id": "c12q3o1",
      "text": "할인이 이미 끝났어요",
      "duration": 2.737,
      "bytes": 17084,
      "rms": 1615
    },
    {
      "id": "c12q3o2",
      "text": "수업 전에만 가능해요",
      "duration": 2.821,
      "bytes": 17516,
      "rms": 1784
    },
    {
      "id": "c12q4o0",
      "text": "체육관",
      "duration": 1.791,
      "bytes": 11324,
      "rms": 1355
    },
    {
      "id": "c12q4o1",
