      "bytes": 8300,
      "rms": 1095
    },
    {
      "id": "c11q4o2",
      "text": "학교",
      "duration": 1.59,
      "bytes": 10172,
      "rms": 1510
    },
    {
      "id": "c11q5o0",
      "text": "동생은 매운 음식을 못 먹어요",
      "duration": 3.104,
      "bytes": 19244,
      "rms": 1879
    },
    {
      "id": "c11q5o1",
      "text": "둘 다 매운 음식을 좋아해요",
      "duration": 2.96,
      "bytes": 18380,
      "rms": 1761
    },
    {
      "id": "c11q5o2",
      "text": "저는 매운 음식을 못 먹어요",
      "duration": 2.921,
      "bytes": 18092,
      "rms": 1931
    },
    {
      "id": "c12q1o0",
      "text": "무료로 들어가요",
      "duration": 2.029,
      "bytes": 12764,
      "rms": 1738
    },
    {
      "id": "c12q1o1",
      "text": "돈을 내야 해요",
      "duration": 2.211,
      "bytes": 13916,
      "rms": 1606
    },
    {
      "id": "c12q1o2",
      "text": "문이 닫혀 있어요",
      "duration": 2.312,
      "bytes": 14492,
      "rms": 1705
    },
    {
      "id": "c12q2o0",
      "text": "9시 30분",
      "duration": 2.223,
      "bytes": 13916,
      "rms": 1737
    },
    {
      "id": "c12q2o1",
