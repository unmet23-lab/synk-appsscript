      "bytes": 12188,
      "rms": 1497
    },
    {
      "id": "c09q2o2",
      "text": "오후 5시",
      "duration": 1.98,
      "bytes": 12476,
      "rms": 1635
    },
    {
      "id": "c09q3o0",
      "text": "걸어야 해요",
      "duration": 1.895,
      "bytes": 11900,
      "rms": 1605
    },
    {
      "id": "c09q3o1",
      "text": "자전거를 타야 해요",
      "duration": 2.213,
      "bytes": 13916,
      "rms": 1537
    },
    {
      "id": "c09q3o2",
      "text": "차를 타야 해요",
