      "id": "c09q2o0",
      "text": "오후 3시",
      "duration": 1.81,
      "bytes": 11468,
      "rms": 1512
    },
    {
      "id": "c09q2o1",
      "text": "오전 10시",
      "duration": 2.007,
      "bytes": 12620,
      "rms": 1527
    },
    {
      "id": "c09q2o2",
      "text": "오후 5시",
      "duration": 2.082,
      "bytes": 13052,
      "rms": 1653
    },
    {
      "id": "c09q3o0",
      "text": "걸어야 해요",
      "duration": 1.973,
      "bytes": 12476,
      "rms": 1552
    },
    {
      "id": "c09q3o1",
      "text": "자전거를 타야 해요",
      "duration": 2.459,
      "bytes": 15356,
      "rms": 1820
    },
    {
      "id": "c09q3o2",
      "text": "차를 타야 해요",
      "duration": 2.375,
      "bytes": 14780,
      "rms": 1655
    },
    {
      "id": "c09q4o0",
      "text": "계산대",
