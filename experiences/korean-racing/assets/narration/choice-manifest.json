      "rms": 1727
    },
    {
      "id": "c12q3o0",
      "text": "받을 수 있어요",
      "duration": 2.091,
      "bytes": 13196,
      "rms": 1671
    },
    {
      "id": "c12q3o1",
      "text": "할인이 이미 끝났어요",
      "duration": 2.55,
      "bytes": 15932,
      "rms": 1775
    },
    {
      "id": "c12q3o2",
      "text": "수업 전에만 가능해요",
      "duration": 2.494,
      "bytes": 15500,
      "rms": 1853
    },
    {
      "id": "c12q4o0",
