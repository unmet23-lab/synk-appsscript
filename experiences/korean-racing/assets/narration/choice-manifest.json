      "bytes": 11756,
      "rms": 1625
    },
    {
      "id": "c10q4o2",
      "text": "흰 우산",
      "duration": 1.755,
      "bytes": 11180,
      "rms": 1507
    },
    {
      "id": "c10q5o0",
      "text": "돈을 내지 않아요",
      "duration": 2.259,
      "bytes": 14204,
      "rms": 1647
    },
    {
      "id": "c10q5o1",
      "text": "1층에서 만나요",
