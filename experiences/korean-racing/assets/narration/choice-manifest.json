      "bytes": 9020,
      "rms": 1083
    },
    {
      "id": "c11q5o0",
      "text": "동생은 매운 음식을 못 먹어요",
      "duration": 3.425,
      "bytes": 21116,
      "rms": 2958
    },
    {
      "id": "c11q5o1",
      "text": "둘 다 매운 음식을 좋아해요",
      "duration": 3.141,
      "bytes": 19388,
      "rms": 2854
    },
    {
      "id": "c11q5o2",
      "text": "저는 매운 음식을 못 먹어요",
      "duration": 3.182,
      "bytes": 19676,
      "rms": 3035
    },
    {
      "id": "c12q1o0",
      "text": "무료로 들어가요",
