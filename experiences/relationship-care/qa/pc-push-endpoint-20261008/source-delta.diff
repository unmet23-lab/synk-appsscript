+test('all four Chromium Google gateways register, dispatch once and support device settings', async () => {
+  const bases = ['https://fcm.googleapis.com/fcm/send/', 'https://fcm.googleapis.com/wp/',
+    'https://fcm.googleapis.com/preprod/wp/', 'https://jmt17.google.com/fcm/send/'];
+  for (const base of bases) {
+    const subscription = { ...sub(), endpoint: base + 'Synthetic_token-123:Ab' };
+    assert.equal(validateSubscription(subscription).endpoint, subscription.endpoint);
+    const a = await opted(undefined, subscription), calls = [];
+    const send = createCarePushSender({ publicKey, privateKey: key.getPrivateKey().toString('base64url'), validateSubscription,
+      webpush: { async sendNotification(sent, payload) { calls.push({ sent, payload }); } } });
+    assert.equal((await a.call({ action: 'status', endpoint: subscription.endpoint })).enabled, true);
+    assert.equal((await process(a.deviceId, send)).outcome, 'sent');
+    assert.equal((await process(a.deviceId, send)).outcome, 'not-due');
+    assert.equal(calls.length, 1);
+    assert.equal(calls[0].sent.endpoint, subscription.endpoint);
+    assert.deepEqual(JSON.parse(calls[0].payload), { type: 'synk-care-digest' });
+    assert.equal((await a.call({ action: 'update', endpoint: subscription.endpoint, hour: 10, minute: 15 })).hour, 10);
+    assert.equal((await a.call({ action: 'unsubscribe', endpoint: subscription.endpoint })).enabled, false);
+  }
+});
+
+test('Google gateway compatibility keeps exact hosts, prefixes and token boundaries before external I/O', async () => {
+  const bases = ['https://fcm.googleapis.com/fcm/send/', 'https://fcm.googleapis.com/wp/',
+    'https://fcm.googleapis.com/preprod/wp/', 'https://jmt17.google.com/fcm/send/'];
+  const endpoints = [
+    'https://jmt18.google.com/fcm/send/synthetic', 'https://push.jmt17.google.com/fcm/send/synthetic',
+    'https://jmt17.google.com.evil.invalid/fcm/send/synthetic', 'https://jmt17.google.com@127.0.0.1/fcm/send/synthetic',
+    'https://jmt17.google.com/wp/synthetic', 'https://jmt17.google.com/preprod/wp/synthetic',
+    'https://fcm.googleapis.com/preprod/fcm/send/synthetic', 'https://fcm.googleapis.com/other/wp/synthetic',
+    'https://fcm.googleapis.com/wpush/synthetic', 'https://jmt17.google.com/fcm/sendish/synthetic',
+  ];
+  for (const base of bases) {
+    endpoints.push(base, ...['a/b', 'a\\b', 'a+b', 'a=b', 'a.b', 'a%2Fb', '%61mbiguous', 'a%00b', 'a%252Fb', '%2e%2e/a', 'a?', 'a#', 'a?token=x', 'a#fragment'].map(token => base + token),
+      base.replace('https:', 'http:') + 'a', base.replace('https://', 'https://user@') + 'a',
+      base.replace('.com/', '.com:443/') + 'a', base.replace('.com/', '.com:8443/') + 'a',
+      base.replace('.com/', '.com/x/../') + 'a');
+  }
+  let externalCalls = 0;
+  const send = createCarePushSender({ publicKey, privateKey: key.getPrivateKey().toString('base64url'), validateSubscription,
+    webpush: { async sendNotification() { externalCalls++; } } });
+  for (const endpoint of endpoints) {
+    const subscription = { ...sub(), endpoint };
+    assert.throws(() => validateSubscription(subscription), { code: 'INVALID_SUBSCRIPTION' }, endpoint);
+    await assert.rejects(send({ subscription }), { code: 'INVALID_SUBSCRIPTION' }, endpoint);
+  }
+  assert.equal(externalCalls, 0);
+});
