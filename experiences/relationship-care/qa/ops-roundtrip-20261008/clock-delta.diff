+      const due = should(payload, options); assert.equal(due, true);
+      clock = '2026-10-08T01:30:00Z'; return due;
+    } });
+  assert.equal(result.outcome, 'skipped'); assert.equal(capture.calls.length, 0);
+  const [receipt] = await sql`select delivery_state,last_outcome from engine.synk_care_push_subscriptions where device_id=${a.deviceId}::uuid`;
+  assert.deepEqual(receipt, { delivery_state: 'settled', last_outcome: 'skipped' });
+});
+
+test('retry backoff starts at rejection time and never outlives its original dispatch window', async () => {
+  for (const boundary of [
+    { start: NOW, end: '2026-10-08T00:01:08Z', hour: 9, minute: 0, retryAt: '2026-10-08T00:06:08.000Z' },
+    { start: '2026-10-08T01:24:59Z', end: '2026-10-08T01:25:00Z', hour: 9, minute: 0, retryAt: null },
+    { start: '2026-10-08T14:54:59Z', end: '2026-10-08T14:55:00Z', hour: 23, minute: 30, retryAt: null },
+    { start: '2026-10-08T14:59:59Z', end: '2026-10-08T15:00:07Z', hour: 23, minute: 59, retryAt: null },
+  ]) {
+    const a = await subscribed(); let clock = boundary.start, calls = 0;
+    await a.push({ action: 'update', endpoint: a.sub.endpoint, hour: boundary.hour, minute: boundary.minute });
+    const result = await processDevice(a.deviceId, async () => { calls++; clock = boundary.end; return { outcome: 'retry' }; }, () => new Date(clock));
+    assert.equal(result.outcome, 'retry'); assert.equal(calls, 1);
+    const [receipt] = await sql`select delivery_state,next_attempt_at from engine.synk_care_push_subscriptions where device_id=${a.deviceId}::uuid`;
+    assert.equal(receipt.delivery_state, boundary.retryAt ? 'retry' : 'settled', boundary.end);
+    assert.equal(receipt.next_attempt_at ? new Date(receipt.next_attempt_at).toISOString() : null, boundary.retryAt);
+    if (boundary.retryAt) {
+      assert.equal((await processDevice(a.deviceId, async () => { calls++; return { outcome: 'sent' }; }, '2026-10-08T00:06:07Z')).outcome, 'not-due');
+      assert.equal((await processDevice(a.deviceId, async () => { calls++; return { outcome: 'sent' }; }, boundary.retryAt)).outcome, 'sent');
+      assert.equal(calls, 2);
+    }
+  }
+});
