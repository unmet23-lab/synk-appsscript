+
+test('a slow gateway cannot carry later devices past Korean midnight or the 90-minute window', async () => {
+  for (const boundary of [
+    { start: '2026-10-08T14:59:59Z', end: '2026-10-08T15:00:07Z', hour: 23, minute: 59 },
+    { start: '2026-10-08T01:29:59Z', end: '2026-10-08T01:30:07Z', hour: 9, minute: 0 },
+  ]) {
+    const first = await subscribed(), second = await subscribed();
+    const ids = [first.deviceId, second.deviceId], realStore = createCarePushStore(sql);
+    for (const a of [first, second]) await a.push({ action: 'update', endpoint: a.sub.endpoint, hour: boundary.hour, minute: boundary.minute });
+    let clock = boundary.start; const sent = [];
+    const worker = createCarePushWorker({ serviceKey: workerKey, enabled: () => true, now: () => new Date(clock),
+      store: { ...realStore, async listDue(options) {
+        const due = await realStore.listDue({ ...options, limit: 100 });
+        assert.equal(ids.every(id => due.includes(id)), true);
+        return ids;
+      } },
+      shouldNotify: createCarePushDue(model), async send({ deviceId }) {
+        sent.push(deviceId); clock = boundary.end; return { outcome: 'sent' };
+      } });
+    const response = await worker(new Request('https://synthetic.invalid/synk-care-push-send', {
+      method: 'POST', headers: { authorization: 'Bearer ' + workerKey },
+    }));
+    assert.equal(response.status, 200);
+    assert.deepEqual(sent, [first.deviceId], boundary.start);
+    assert.deepEqual(await response.json(), { ok: true, processed: 2, sent: 1, retry: 0, gone: 0, failed: 0, skipped: 1 });
+    const [receipt] = await sql`select attempt_day::text,attempt_count from engine.synk_care_push_subscriptions where device_id=${second.deviceId}::uuid`;
+    assert.equal(receipt.attempt_day, null); assert.equal(receipt.attempt_count, 0);
+  }
+});
+
+test('claim eligibility uses the time after acquiring the account lock', async () => {
+  const a = await subscribed(), capture = senderCapture();
+  let clock = '2026-10-08T01:29:59Z';
+  const intercepted = (...args) => sql(...args);
+  intercepted.begin = callback => sql.begin(q => callback(async (parts, ...values) => {
+    const rows = await q(parts, ...values);
+    if (parts[0].startsWith('select * from engine.synk_accounts')) clock = '2026-10-08T01:30:00Z';
+    return rows;
+  }));
+  const result = await processDevice(a.deviceId, capture.send, () => new Date(clock), createCarePushStore(intercepted));
+  assert.equal(result.outcome, 'not-due'); assert.equal(capture.calls.length, 0);
+  const [receipt] = await sql`select attempt_day::text,attempt_count from engine.synk_care_push_subscriptions where device_id=${a.deviceId}::uuid`;
+  assert.equal(receipt.attempt_day, null); assert.equal(receipt.attempt_count, 0);
+});
+
+test('a claim that expires before dispatch is settled without a gateway send', async () => {
+  for (const boundary of [
+    { start: '2026-10-08T14:59:59Z', end: '2026-10-08T15:00:00Z', hour: 23, minute: 59 },
+    { start: '2026-10-08T01:29:59Z', end: '2026-10-08T01:30:00Z', hour: 9, minute: 0 },
+    { start: NOW, end: '2026-10-09T00:01:00Z', hour: 9, minute: 0 },
+  ]) {
+    const a = await subscribed(), capture = senderCapture();
+    await a.push({ action: 'update', endpoint: a.sub.endpoint, hour: boundary.hour, minute: boundary.minute });
+    let clock = boundary.start, transactions = 0;
+    const intercepted = (...args) => sql(...args);
+    intercepted.begin = async callback => {
+      const value = await sql.begin(callback);
+      if (++transactions === 1) clock = boundary.end;
+      return value;
+    };
+    const result = await processDevice(a.deviceId, capture.send, () => new Date(clock), createCarePushStore(intercepted));
+    assert.equal(result.outcome, 'skipped', boundary.end); assert.equal(capture.calls.length, 0);
+    const [receipt] = await sql`select attempt_day::text,attempt_count,delivery_state,last_outcome,next_attempt_at
+      from engine.synk_care_push_subscriptions where device_id=${a.deviceId}::uuid`;
+    assert.deepEqual(receipt, { attempt_day: '2026-10-08', attempt_count: 1, delivery_state: 'settled', last_outcome: 'skipped', next_attempt_at: null });
+  }
+});
+
+test('eligibility is rechecked after an asynchronous notebook decision and immediately before send', async () => {
+  const a = await subscribed(), capture = senderCapture(), should = createCarePushDue(model);
+  let clock = '2026-10-08T01:29:59Z';
+  const result = await createCarePushStore(sql).processDue(a.deviceId, { now: () => new Date(clock), send: capture.send,
