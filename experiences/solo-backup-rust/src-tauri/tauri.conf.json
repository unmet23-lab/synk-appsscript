  "version": "0.7.5",
  "identifier": "im.synk.workbackup",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["synk-workbackup"] } },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0NTBEQzE4NkVENzA2QTkKUldTcEJ0ZHVHTnhRNU1TSjllZTBJZFRyNlZIVE1IR1l2YiswcFdFdEFNSXMvc3luaEJPZVpnb3MK",
      "endpoints": ["https://synk.im/desktop/releases/workbackup.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    },
    "synkUpdate": { "recoveryPubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREOUZENUU0RDhGREZCNkEKUldScSsvM1k1TldmVGRhdkk3QWJ2eHhKT3VlbFlJczZhOHN4bFBSUXY5ZmFjb2svQnkwUE9rcmcK" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SYNK",
    "icon": ["icons/icon.ico"],
    "windows": {
      "allowDowngrades": false,
      "nsis": { "installMode": "perMachine", "languages": ["Korean"] }
    }
  }
}
