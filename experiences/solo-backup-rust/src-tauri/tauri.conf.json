{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SYNK 업무 백업",
  "mainBinaryName": "WorkBackup",
  "version": "0.7.0",
  "identifier": "im.synk.workbackup",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": { "deep-link": { "desktop": { "schemes": ["synk-workbackup"] } } },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SYNK",
    "icon": ["icons/icon.ico"],
    "windows": {
      "allowDowngrades": false,
      "nsis": { "installMode": "perMachine", "languages": ["Korean"] }
    }
  }
}
