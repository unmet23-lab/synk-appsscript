# 줄끝·차이 표시·병합 정책. 이 파일은 훅을 설치하거나 실행하지 않는다.
# 셸 스크립트는 LF로 체크아웃한다. 저장소 전체 줄끝 재정규화는 하지 않는다.
tools/githooks/** text eol=lf

# 형제 저장소와 계약 파일의 바이트를 맞춘다.
계약/** text eol=lf

# 생성 지면은 생성기와 같은 LF를 사용해 내용 없는 차이를 막는다.
docs/이해대장.html text eol=lf

docs/Loom_부품_시연.html text eol=lf

# 폰트 내장 발표물은 거대 diff를 숨긴다. 원고 _src_*.html은 검토 가능하다.
# -diff만 지정한다. binary로 넓히면 병합·줄끝 동작까지 바뀐다.
docs/발표물/[0-9]*.html -diff
docs/발표물/*.pdf -diff

# 추가형 장부의 양쪽 새 행을 보존한다. 같은 행을 수정하면 중복될 수 있어 대조한다.
docs/_ops/장부/*.md merge=union

# 루트 운영 JSONL 장부에만 적용한다. 다른 JSONL에 넓히지 않는다.
docs/_ops/*.jsonl merge=union

# Atlas 동결 평가가 해시로 묶은 원본·평가 문장·봉인 기록. 어느 작업본에서 꺼내도 같은 바이트(LF)여야
# 캡처 도구와 서버의 실행판 확인이 통과한다. core.autocrlf가 켜진 새 체크아웃에서 깨지던 것을 막는다.
atlas/domain.js text eol=lf
atlas/interpretation.js text eol=lf
atlas/temper-interpretation.js text eol=lf
experiences/atlas-lab/interpretation.mjs text eol=lf
experiences/atlas-lab/model-extraction.mjs text eol=lf
docs/마케팅/맞춤도구/computer/content.js text eol=lf
tests/fixtures/atlas-interpretation-heldout-v1.json text eol=lf
tests/fixtures/atlas-interpretation-heldout-v1.manifest.json text eol=lf
docs/_ops/qa/atlas-model-20261005/freeze.json text eol=lf

# 런처·맞춤 도구의 엔진 manifest는 실제 바이트를 기록하므로 원본과 사본의 줄끝을 고정한다.
atlas/engine.js text eol=lf
atlas/personalization.js text eol=lf
desktop/assets/launcher/engine.js text eol=lf
desktop/assets/launcher/personalization.js text eol=lf
docs/마케팅/맞춤도구/dist/**/atlas-engine.js text eol=lf

# 보존 패치의 빈 문맥 줄에는 형식상 한 칸이 필요하다.
docs/_ops/qa/atlas-eight-fix-20261008/*.patch -whitespace

tests/fixtures/member-statement-*.json text eol=lf
experiences/synk-account/src/member-statement*.cjs text eol=lf

# 플랫폼 연속성 번들은 생성기가 LF로 쓰고 --check와 네이티브 검사 도구가 바이트를 그대로 대조하므로 줄끝을 고정한다.
desktop/renderer/platform-continuity.mjs text eol=lf
desktop/renderer/platform-continuity.css text eol=lf
