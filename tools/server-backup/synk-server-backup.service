[Unit]
Description=SYNK encrypted recovery copies independent of laptop
After=network-online.target
Wants=network-online.target
OnFailure=synk-server-backup-watch.service

[Service]
Type=oneshot
User=root
UMask=0077
StateDirectory=synk-server-backup
StateDirectoryMode=0700
ExecStart=/usr/bin/flock --nonblock /var/lib/synk-server-backup/run.lock /opt/synk/ha-runtime/node /opt/synk-server-backup/backup.cjs
TimeoutStartSec=3h
Nice=15
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=768M
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/synk-server-backup -/var/lib/synk-argon-77yuhbs/.config/gws-docs
ProtectHome=true
NoNewPrivileges=true

