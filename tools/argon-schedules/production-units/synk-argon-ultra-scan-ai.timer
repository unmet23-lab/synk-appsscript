# Activation is controlled by production-ready.
# Asia/Seoul is explicit; host timezone must not determine the schedule.
[Unit]
Description=SYNK Monday scan - AI news, questions and build-in-public trends schedule
ConditionPathExists=/etc/synk-argon-77yuhbs/production-ready

[Timer]
OnCalendar=Mon *-*-* 02:00:00 Asia/Seoul
Unit=synk-argon-ultra-scan-ai.service
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false

[Install]
WantedBy=timers.target


