# Activation is controlled by production-ready.
# Asia/Seoul is explicit; host timezone must not determine the schedule.
[Unit]
Description=SYNK YouTube and TikTok research schedule
ConditionPathExists=/etc/synk-argon-77yuhbs/production-ready

[Timer]
OnCalendar=*-*-* 08,14,20:00:00 Asia/Seoul
Unit=synk-argon-ultra-yt-tt.service
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false

[Install]
WantedBy=timers.target


