# Activation is controlled by production-ready.
# Asia/Seoul is explicit; host timezone must not determine the schedule.
[Unit]
Description=SYNK Meta and brand research schedule
ConditionPathExists=/etc/synk-argon-77yuhbs/production-ready

[Timer]
OnCalendar=*-*-* 11,17,23:00:00 Asia/Seoul
Unit=synk-argon-ultra-meta-brand.service
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false

[Install]
WantedBy=timers.target


