#!/bin/sh
# SYNK commit-msg — 원시 제어문자(C0·DEL)가 커밋 **메시지**로 들어가는 것을 막는다.
# (F454 처방 · 2026-08-15)
#
# 왜 별도 훅인가 — `pre-commit` 은 메시지를 **못 본다**. 이 저장소 규약은 여러 줄 메시지를
#   스크래치패드 파일에 써서 `git commit -F` 로 넘기는 것이라(CLAUDE.md 셸 조항), 그 파일은
#   추적 파일도 아니어서 어떤 파일 게이트에도 안 걸린다. F454 사고 ②가 정확히 그 자리다.
#
# 🔴 여기가 **가장 비싼 자리**다 — 파일은 다음 커밋에서 고치면 되지만, 메시지에 박힌 바이트는
#   커밋되는 순간 git 이력에 영원히 남는다(고치려면 이력 재작성이고 그건 남의 커밋까지 흔든다).
#   그래서 이 훅만은 「없으면 말하고 넘어간다」가 아니라 **있으면 반드시 막는다**.
#
# 🔑 판정은 여기서 안 한다 — `tools/제어문자검사.js` 하나가 진다(같은 판정을 두 곳에 적으면
#   갈라지고, 갈라지는 방향은 언제나 「통과」다). 여기는 발동 조건만 맡는다.
#   `#` 로 시작하는 안내 주석은 그 도구가 뺀다 — 그건 커밋에 안 들어가므로 잡으면 따를 수 없는
#   처방이 된다(F103).
#
# ⚠ `prepare-commit-msg` 에 얹지 않았다 — 그쪽은 「실패해도 커밋을 막지 않는다」가 설계 원칙이고
#   (귀속은 편의지 안전장치가 아니다), 차단을 섞으면 그 원칙이 갈린다. 훅 하나에 성격이 다른 두
#   일을 넣으면 다음 사람이 어느 쪽 규약인지 못 읽는다.
#
# 정본은 이 파일(repo). `.git/hooks/` 의 사본은 설치본이다 — 고칠 때는 여기를 고치고
# `node tools/install-githooks.js` 로 다시 설치한다.
set -e

MSG_FILE="$1"
[ -n "$MSG_FILE" ] || exit 0
[ -f "$MSG_FILE" ] || exit 0

ROOT=$(git rev-parse --show-toplevel)

if [ -f "$ROOT/tools/제어문자검사.js" ]; then
  node "$ROOT/tools/제어문자검사.js" --메시지 "$MSG_FILE"
else
  echo "[제어문자] 검사기가 없어 커밋 메시지 대조를 **못 했다** — $ROOT/tools/제어문자검사.js" >&2
fi
