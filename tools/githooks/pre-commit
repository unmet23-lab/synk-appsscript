#!/bin/sh
# 계약이 두 저장소에서 갈라진 채 커밋되는 것을 막는다. (유호님 확정 ㉮ · 2026-08-07)
#
# 왜 훅인가 — 갈라짐을 잡던 유일한 장치가 `tests/계약.test.js` 인데 그건 형제 저장소가 없으면
#   `t.skip` 이고, GitHub Actions 는 자기 저장소만 checkout 한다. 그래서 **계약이 갈라져도
#   양쪽 CI 가 다 초록**이었다(2026-08-07 설계 심문이 지목 · 워크플로 2개 실측으로 확인).
#   닿는 경로도 실재한다: 폰 클라우드 세션엔 형제가 없어 로컬 검사도 skip 된다.
#
# 🔑 판정은 여기서 안 한다 — `tools/계약동기화.js` 하나가 진다(같은 판정을 두 곳에 적으면
#   갈라지고, 갈라지는 방향은 언제나 「통과」다). 이 훅은 **발동 조건**만 맡는다.
#
# ⚠ 형제가 없는 기계에서는 그 도구가 「건너뜀」을 **말하고** 0으로 끝난다 — 막지 않는다.
#   통과와 미실행이 같은 모양이면 안 되므로, 조용히 넘기지 말고 그 문장이 보이게 둔다.
#
# ☠️ `-z` 인 이유: 기본 출력은 비ASCII 경로를 `"\352\263\204..."` 로 이스케이프해서
#   한글 경로 대조가 **영원히 안 맞는다**(= 검사가 안 도는데 초록). repo 의 quotepath 설정은
#   건드리지 않는다.
set -e

ROOT=$(git rev-parse --show-toplevel)

# ── 게이트 «초» 기록 ────────────────────────────────────────────────────────
# 무엇을 — 아래 게이트 일곱이 각각 몇 ms 걸렸는지를 `docs/_ops/게이트초.jsonl` 에 한 줄 남긴다.
# 왜 — 「커밋 게이트가 사람을 얼마나 기다리게 하나」를 판정하려면 재료가 있어야 하는데 지금은
#   아무도 안 잰다. **읽는 자리는 `tools/rot-check.js` 가 진다 — 여기는 기록만 한다**
#   (같은 것을 두 곳에서 재면 반드시 갈린다).
# 🔴 **이 장부는 git 이 안 쥔다 — 로컬 파일이다**(2026-08-30 · 트랙 §0-자 ⓑ · `.gitignore` 에 근거).
#   까닭이 «구조»다: 이 append 는 커밋 **중**에 일어나므로 그 줄은 원리상 이 커밋에 못 담기고
#   **항상 다음 커밋으로 밀린다.** 추적하는 한 `git status` 가 영영 안 깨끗해지고, 그러면
#   ①진짜 미커밋이 상시 잡음에 가리고 ②`codex-review` 가 과녁 없이 불렸을 때 이 한 줄을
#   검수 대상으로 삼는다(F292 통로). 둘 다 실제로 났다. 값도 **이 기계의 ms** 라 기계를 섞으면
#   중앙값이 거짓이 된다. 읽는 쪽(`rot-check.js`)은 이미 「없으면 조용히 넘어간다」로 짜여 있다.
# 형식 — {"시각":ISO,"커밋":"pending","게이트":{"이름":ms 또는 사유문자열,…},"합":ms}
#   · 수 = 실제로 돌아서 잰 값 / 문자열 = 안 돌았거나 못 쟀다("검사기없음" · "해당없음" · "못잼")
#   · 키가 아예 없다 = 거기까지 못 갔다(앞 게이트가 막았다). 0ms 로 위장시키지 않는다.
#   · `합` 은 **수인 것만** 더한다. 안 돈 게이트를 0으로 세면 「빨랐다」로 읽힌다.
#   · 커밋 sha 는 pre-commit 시점엔 아직 없다 — 그래서 언제나 "pending" 이다(지어내지 않는다).
#     ⚠ **그리고 영영 pending 이다 — 채우지 «않기로» 했다**(08-30 판정). post-commit 으로 마지막
#     줄을 sha 로 갈아 끼우는 길이 있었지만, 이 기계는 **세션 일곱이 동시에 커밋**한다. 그 사이
#     남이 한 줄 append 하면 **남의 줄에 내 sha 를 박는다** — 지금 이 append 가 「한 줄을 통째로
#     만들어 한 번에 쓴다」로 얻은 무경합을 그대로 잃는다. 커밋 열쇠 하나를 얻자고 장부 전체의
#     신뢰를 거는 거래라 안 했다. 읽는 쪽도 이미 「커밋 열쇠로 묶지 않는다」로 명시돼 있다.
#   · `시각` 은 **진짜 UTC** 다(08-30 정정 — 아래 gate_flush 의 `export` 주석을 볼 것).
#     ✅ 그 버그 때 KST 로 찍혔던 **첫 세 줄은 08-30 에 UTC 로 되돌렸다**(9시간 차 · 그 줄에
#     `"보정"` 칸이 남아 있다). 같이 시각순 정렬도 했다 — codex 가 「행 순서도 시각순이 아니다」를
#     같이 지적했다(`9a18264607a8`). 앞판이 「덧쓰는 중이라 못 고친다」고 미뤄 둔 자리인데,
#     **읽은 뒤 늘어난 줄을 쓰기 직전에 다시 읽어 뒤에 붙이면** 잃지 않는다(그 방식으로 고쳤다).
#
# ☠️ **시간 재기가 커밋을 늦추면 본말전도다.** 그래서 `date` 를 안 부른다 — 이 기계에서
#    `date +%s%3N` 는 한 번에 ≈20ms(10회 197ms 실측 08-29)라 8번이면 160ms 를 얹는다.
#    bash 내장 `$EPOCHREALTIME` 은 포크가 0이라 10회에 0.16ms 였다(실측 08-29).
#    ⚠ 이 판단의 «분모»를 여기 적지 않는다 — 게이트 합의 정본은 장부 자신(`게이트초.jsonl`)이다.
#    앞판이 손으로 잰 「바닥값」은 **스테이징 0건** 조건의 값이라 실커밋에는 안 맞았다
#    (08-29 실커밋 줄이 그보다 훨씬 컸다). 그 수는 `tools/rot-check.js` 의 `게이트_바닥값_ms`
#    **하나가** 안다 — 여기 다시 베끼면 08-30 에 갈렸던 그 자리가 또 갈린다.
# ⚠ 그 대가로 **bash 전용**이다. sh 가 dash 인 기계에선 못 잰다 — 그때는 조용히 0을 쓰지 않고
#    「못 쟀다」를 stderr 로 말하고 줄을 안 남긴다(통과와 미실행이 같은 모양이면 안 된다).
# ☠️ **여기 이름만 로마자인 까닭** — 이 저장소는 함수·변수에도 한글을 쓰지만 **bash 변수 이름은
#    ASCII 만 된다**. `게이트초_켬=1` 은 파싱은 통과하고 실행 때 `command not found`(종료 127)로
#    죽는다 — 즉 훅이 **첫 게이트도 못 돌고** 커밋을 막는다(08-29 실측 · 그래서 로마자다).
#    함수 이름은 한글이 되지만, 절반만 한글이면 다음 사람이 규칙을 오해한다 — 이 블록은 통째 로마자.
# ☠️ **꼴까지 본다 — 있다는 것만으론 모자란다.** `$EPOCHREALTIME` 은 **로케일의 소수점**을 쓴다.
#    소수점이 쉼표인 로케일(de_DE 등)에선 `1788024028,689613` 이 오고, `${…%%.*}` 가 통째로 남아
#    bash 산술이 쉼표를 «콤마 연산자»로 읽는다 — 죽지도 않고 **소수부만** 값이 되어 장부에 거짓 수가
#    쌓인다(08-30 지적). 그래서 「숫자와 점만 · 점이 하나라도 있다」를 통과선으로 둔다.
case ${EPOCHREALTIME-} in
  ''|*[!0-9.]*) GATE_MS_ON='' ;;   # 없거나(dash) 모르는 꼴(쉼표 소수점 등)
  *.*)          GATE_MS_ON=1 ;;
  *)            GATE_MS_ON='' ;;   # 점이 없다 = 밀리초가 없다
esac
GATE_MS_ITEMS=''
GATE_MS_SUM=0

gate_now_ms() {  # 결과는 $GATE_MS_NOW 에 넣는다 — echo 로 돌려주면 서브셸 포크라 비싸다
  _gsec=${EPOCHREALTIME%%.*}
  _gfrac=${EPOCHREALTIME#*.}000
  _gmil=${_gfrac%"${_gfrac#???}"}
  GATE_MS_NOW=$(( _gsec * 1000 + 10#$_gmil ))   # 10# 없으면 「062」가 8진수로 읽힌다
}

gate_record() {  # $1=이름 $2=ms 또는 사유
  case "$2" in
    ''|*[!0-9]*) _gval="\"$2\"" ;;
    *) _gval="$2"; GATE_MS_SUM=$(( GATE_MS_SUM + $2 )) ;;
  esac
  GATE_MS_ITEMS="${GATE_MS_ITEMS:+$GATE_MS_ITEMS,}\"$1\":$_gval"
}

gate_run() {  # $1=이름, 나머지=실행할 명령
  _gname=$1; shift
  if [ -z "$GATE_MS_ON" ]; then "$@"; return $?; fi
  gate_now_ms; _gstart=$GATE_MS_NOW
  _gcode=0
  "$@" || _gcode=$?          # `||` 가 set -e 를 여기서만 눌러, 실패해도 끝시각을 잰다
  gate_now_ms
  # ☠️ 시계가 뒤로 가면(NTP 되감기) 차가 **음수**다. 음수를 그대로 넘기면 `gate_record` 의
  #    `*[!0-9]*` 가 `-` 를 물어 «사유 문자열» 갈래로 떨어지고, 규격상 그건 「안 돌았다」다 —
  #    실제로는 **돌았는데 못 잰 것**이라 뜻이 정반대로 뒤집힌다. 규격이 이미 가진 「못 잼」 자리로
  #    떨어뜨린다(수가 아니니 `합` 에서도 빠지고, 그 사실이 이름째 보인다).
  _gdiff=$(( GATE_MS_NOW - _gstart ))
  if [ "$_gdiff" -lt 0 ]; then gate_record "$_gname" 못잼; else gate_record "$_gname" "$_gdiff"; fi
  return $_gcode             # 0 이 아니면 바깥 set -e 가 커밋을 막는다(원래 동작 그대로)
}

# 실패로 중단돼도 여기까지 잰 것은 남긴다 — 「느려서 죽었나」를 나중에 못 보면 잰 뜻이 없다.
gate_flush() {
  [ -n "$GATE_MS_ON" ] || return 0
  _gledger="$ROOT/docs/_ops/게이트초.jsonl"
  # ☠️ **`export` 가 없으면 시간대가 «안 바뀐다».** `TZ=UTC` 만 쓰면 bash 의 `%(…)T` 는 여전히
  #    로컬(KST)로 찍고 거기에 `Z` 를 달아 **+9시간 · 날짜까지 하루 빠른** 거짓 시각이 된다
  #    (08-30 실측: 훅 현행판 `…T02:48:00Z` ↔ 진짜 UTC `…T17:48:00Z`). 지금은 읽는 쪽이 `시각` 을
  #    안 봐서 **증상이 0** 이라 더 위험했다 — 누가 「장부가 언제 자랐나」를 붙이는 순간 언제나
  #    «미래»라 영원히 신선해 보인다. 짝 장부 `밤굽기도장.json` 은 `toISOString()` 라 진짜 UTC 다.
  _gtz=${TZ-}; _gtzset=${TZ+set}
  export TZ=UTC; printf -v _gnow '%(%Y-%m-%dT%H:%M:%SZ)T' -1
  if [ -n "$_gtzset" ]; then export TZ="$_gtz"; else unset TZ; fi
  # 한 줄을 통째로 만들어 **한 번에** 쓴다 — 다섯 세션이 동시에 커밋해도 줄이 섞이지 않게.
  printf '%s
' "{\"시각\":\"$_gnow\",\"커밋\":\"pending\",\"게이트\":{$GATE_MS_ITEMS},\"합\":$GATE_MS_SUM}"     >> "$_gledger" 2>/dev/null || echo "[게이트초] 장부에 못 적었다 — $_gledger" >&2
}
if [ -n "$GATE_MS_ON" ]; then
  trap gate_flush EXIT
else
  echo "[게이트초] 이 셸의 밀리초 시계가 없거나 모르는 꼴이라 게이트 초를 **못 쟀다** — 줄을 남기지 않는다(bash · 소수점이 점인 로케일 필요)" >&2
fi
# ────────────────────────────────────────────────────────────────────────────

if git diff --cached --name-only -z --diff-filter=ACMR \
   | tr '\0' '\n' | grep -qx '계약/수집_교정_계약.json'; then
  gate_run 계약동기화 node "$ROOT/tools/계약동기화.js" --check
else
  gate_record 계약동기화 해당없음
fi

# 계약이 픽스처 조립부를 **두고 가는 것**을 막는다. (자율주행 판정 0814 #26 · 거부권 열림)
#
# 왜 여기인가 — 같은 자리 2번째다(v9.173 `불변` · v9.220 `대안태그`). 계약에 칸을 늘리고
#   `엔진_수집.js` 의 `항목.push({…})` 를 안 고치면 `tests/계약.test.js` 가 사후에 빨개지는데,
#   그 적색은 고친 사람이 아니라 **그 뒤 커밋하는 모든 세션의 배포**를 막는다. 사후 검사는
#   탐지지 예방이 아니라, 지침 신뢰성 조항대로 여기서 기계로 앞당긴다.
#
# 🔑 판정은 여기서 안 한다 — tools/lib/계약동봉.js 하나가 지고, 사후 회귀도 **같은 모듈**을 쓴다
#   (둘이 갈라지면 새는 방향은 언제나 「통과」다). 여기는 발동 조건만 맡는다.
# 🔑 경로 조건을 안 건다 — 대상 판정은 도구 안에 있다. 훅보다 좁은 필터를 앞에 두면 그 필터가
#   곧 구멍이 되고, 같은 판정이 두 곳에 갈려 적힌다(가드 맹점 ③④).
# ⚠ 없으면 막지 않고 말한다 / 있는데 0 아닌 값이면 set -e 가 막는다 — 위 게이트들과 같은 규약.
if [ -f "$ROOT/tools/계약동봉검사.js" ]; then
  gate_run 계약동봉검사 node "$ROOT/tools/계약동봉검사.js" --cached
else
  echo "[계약동봉] 검사기가 없어 동봉 대조를 **못 했다** — $ROOT/tools/계약동봉검사.js" >&2
  gate_record 계약동봉검사 검사기없음
fi

# 정본 개정이 **이해대장 화면을 두고 가는 것**을 막는다. (유호 지시 2026-08-14)
#
# 왜 여기인가 — 같은 자리가 하루에 네 번이었다(08-13 23:35 · 08-14 00:06 · 05:58 · 13:0x, 전부
#   「fix: 이해대장 생성물 재생성 — 주인 없는 적색이 남의 배포를 막고 있었다」). 화면은 정본의 파생인데
#   정본만 커밋되면 `tests/이해대장.test.js` 가 사후에 빨개지고, 그 적색은 낸 사람이 아니라 **그 뒤
#   커밋하는 모든 세션의 배포**를 막는다. 사후 검사는 탐지지 예방이 아니다.
#
# 🔑 판정은 여기서 안 한다 — `tools/이해대장.js --검사` 하나가 지고, 발동 조건은 `tools/대장동봉검사.js`
#   가 맡는다(작업본이 아니라 **커밋될 내용**을 세운다 · F302). 여기는 부르기만 한다.
# ⚠ 없으면 막지 않고 말한다 / 있는데 0 아닌 값이면 set -e 가 막는다 — 위 게이트들과 같은 규약.
if [ -f "$ROOT/tools/대장동봉검사.js" ]; then
  gate_run 대장동봉검사 node "$ROOT/tools/대장동봉검사.js" --cached
else
  echo "[이해대장] 게이트가 없어 동기 대조를 **못 했다** — $ROOT/tools/대장동봉검사.js" >&2
  gate_record 대장동봉검사 검사기없음
fi

# 「쓰는 문자는 한글·몽골어·영어 셋뿐」(유호님 확정 2026-08-07)을 **커밋 때** 발동시킨다.
#
# 왜 여기인가 (F351 · F379): 이 규칙을 지키던 장치는 tests/문서문자.test.js 하나였고 그건
#   스위트를 돌릴 때만 발화한다. 그래서 위반은 늘 「남이 커밋한 뒤 남이 발견」이 됐고,
#   발견자는 그 파일이 남의 작업중 선언이라 손도 못 댔다 — 고칠 수 있는 사람과 발견하는
#   사람이 **반드시 달라지는** 구조였다. 그동안 모든 세션의 test-ci 가 빨갛다.
#
# 🔑 판정은 여기서 안 한다 — tools/lib/옛글자.js 하나가 진다. 여기는 발동 조건만 맡는다.
# 🔑 경로 조건을 안 건다(계약 게이트와 다르다): 어느 파일에나 들어올 수 있는 글자라 경로로
#   미리 좁히면 그 필터가 곧 구멍이 된다. 스테이징분만 훑고 내용은 한 번에 긁으므로 싸다
#   (실측: 200파일 커밋 176ms — 파일 수와 무관).
#
# ⚠ **없으면 막지 않고 말한다 / 고장났으면 막는다** — 둘을 가른다.
#   검사기가 통째로 없는 자리(부분 체크아웃·낡은 워크트리)에서 차단으로 바꾸면 그 세션은
#   아무것도 커밋 못 하고, 따를 수 없는 처방은 우회를 정상 통로로 만든다(F103 · 옆 계약
#   게이트가 같은 이유로 같은 규약을 쓴다). 대신 통과와 미실행이 같은 모양이 되지 않게 찍는다.
#   반대로 있는데 0 아닌 값으로 끝나면(위반이든 크래시든) `set -e` 가 커밋을 막는다.
if [ -f "$ROOT/tools/옛글자검사.js" ]; then
  gate_run 옛글자검사 node "$ROOT/tools/옛글자검사.js" --cached
else
  echo "[옛글자] 검사기가 없어 옛 글자 대조를 **못 했다** — $ROOT/tools/옛글자검사.js" >&2
  gate_record 옛글자검사 검사기없음
fi

# 문서가 **이번에 새로 대는** `파일:줄` 인용이 실제로 그것을 가리키는지 본다. (F350 처방 · 2026-08-12)
#
# 왜 여기인가 — 「file:line 을 인용한 실측 주장이 거짓」이 3번째다(F348→F350). 급소는 틀렸다는
#   사실이 아니라 **증상이 없다**는 것이다: `파일:줄` 을 달고 있어서 다음 독자가 재지 않고 그대로
#   인용하고, 그 위에 설계 판정이 선다(실측 — 처분표의 거짓 주장이 설계 정본으로 전파됐다).
#   커밋이 곧 확정 시점이라 여기가 그 자리다. 편집 시점 알림은 `.claude/hooks/citation-guard.js`.
#
# 🔑 판정은 여기서 안 한다 — tools/인용검사.js 하나가 진다. 여기는 발동 조건만 맡는다.
# 🔑 **이번 커밋이 새로 쓴 줄만** 본다 — 저장소엔 이미 낡은 인용이 있어(실측 🟡10) 전량을 막으면
#   남의 낡은 인용으로 내 커밋이 막힌다. 따를 수 없는 처방은 우회를 정상 통로로 만든다(F103).
# ⚠ 없으면 막지 않고 말한다 / 있는데 0 아닌 값이면 set -e 가 막는다 — 위 두 게이트와 같은 규약.
if [ -f "$ROOT/tools/인용검사.js" ]; then
  gate_run 인용검사 node "$ROOT/tools/인용검사.js" --스테이징
else
  echo "[인용검사] 검사기가 없어 인용 대조를 **못 했다** — $ROOT/tools/인용검사.js" >&2
  gate_record 인용검사 검사기없음
fi

# 확정 안 된 `[vNEXT]` 자리표가 **커밋되는 것**을 막는다. (F450 처방 · 2026-08-15)
#
# 왜 여기인가 — 자리표 설계(F078)가 없애려던 「남의 배포를 막는 적색」이 자리표 자신으로 재현됐다.
#   실측 `694497ad` 가 `엔진_셋업확장.js` 의 `[vNEXT·검수 …]` 2자리를 실었고 `tests/버전채번.test.js`
#   가 빨개져, 그 뒤 모든 세션의 `/deploy` 가 막혔다(유호님이 다음 날 직접 신고). 급소는 그 세션이
#   규칙을 어긴 게 아니라 **낡은 주석을 읽고 그대로 했다**는 것이다 — 그래서 프로즈가 아니라 여기다.
#   사후 검사(test-ci)만 있으면 「고칠 수 있는 사람과 발견하는 사람이 반드시 달라진다」(F351·F379).
#
# 🔑 판정은 여기서 안 한다 — `tools/bump-version.js` 의 `자리표자리` 하나가 지고, 디스크를 읽는
#   `pendingPlaceholders` 도 같은 함수를 쓴다. 여기는 발동 조건만 맡는다.
# 🔑 `--cached` 를 뗄 수 없다 — 작업본을 재면 `git add` 뒤 채번한 커밋을 그대로 통과시킨다(F302).
# 🔑 경로 조건을 안 건다 — 범위(배포 집합)는 도구 안에 있다. 여기 손으로 적으면 두 곳에 갈린다.
# ⚠ 없으면 막지 않고 말한다 / 있는데 0 아닌 값이면 set -e 가 막는다 — 위 게이트들과 같은 규약.
if [ -f "$ROOT/tools/자리표검사.js" ]; then
  gate_run 자리표검사 node "$ROOT/tools/자리표검사.js" --cached
else
  echo "[자리표] 검사기가 없어 자리표 대조를 **못 했다** — $ROOT/tools/자리표검사.js" >&2
  gate_record 자리표검사 검사기없음
fi

# 원시 제어문자(C0·DEL)가 **커밋되는 것**을 막는다. (F454 처방 · 2026-08-15)
#
# 왜 여기인가 — 한 세션에서 **세 번** 났고 세 번째는 신고문 자신 안이었다(`docs/버전_이력.md` ·
#   커밋 메시지 · 판단 층 검토문). 셋 다 같은 동작이다 — 구분자·센티넬을 쓰는 코드를 주석·이력·
#   커밋문에 «사람 말로 설명하기». 이 저장소에서 그건 드문 동작이 아니라 규약이라 재발 조건이
#   상시다. 신뢰성 조항의 「3번째 = 원인을 쓸 수 없게 만든다」 자리다.
# ⚠ 새는 방향이 **조용하다** — 폭이 0이라 에디터·diff 가 안 그리고, `cat -v` 로 찾으러 가야 보인다.
#   실피해가 0이었던 이유는 매번 찾으러 갔기 때문이고 그건 사람 손이다(철학 ㉡).
#
# 🔑 판정은 여기서 안 한다 — `tools/제어문자검사.js` 하나가 진다. 여기는 발동 조건만 맡는다.
# 🔑 **옆 옛글자 게이트의 면제(장부·인계문·evals)를 물려받지 않는다.** 그 면제는 「옛 사고를
#   인용하려면 그 글자를 적어야」 해서인데, 제어문자는 인용도 이스케이프 표기로 한다 — 사유가
#   안 넘어온다. 물려받았으면 사고가 난 그 자리가 영영 안 잡힌다(회귀가 이걸 못박는다).
# ⚠ 없으면 막지 않고 말한다 / 있는데 0 아닌 값이면 set -e 가 막는다 — 위 게이트들과 같은 규약.
if [ -f "$ROOT/tools/제어문자검사.js" ]; then
  gate_run 제어문자검사 node "$ROOT/tools/제어문자검사.js" --cached
else
  echo "[제어문자] 검사기가 없어 제어문자 대조를 **못 했다** — $ROOT/tools/제어문자검사.js" >&2
  gate_record 제어문자검사 검사기없음
fi
