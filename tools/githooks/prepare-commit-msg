#!/bin/sh
# SYNK prepare-commit-msg — 커밋에 세션 ID 트레일러를 박는다.
#
# 왜 있나 (마찰 F041, 2026-08-04 실사고):
#   동시 4세션이 커밋하는 환경에서 **커밋으로 세션을 특정할 수단이 없었다.**
#   author는 전 세션 공통(yuho)이고, Co-Authored-By 모델명은 같은 모델을 쓰는 세션이 여럿이라
#   구분자가 못 되며, 커밋 시각 인접성은 근거가 아니다. 그 결과 타 세션 작업이 내 것으로 오귀속돼
#   **엉뚱한 세션에 검수 회신이 가고 실제 작업자는 피드백을 못 받았다**(같은 세션에서 두 번 틀렸다).
#
# 무엇을 박나: `CLAUDE_CODE_HOST_SESSION_ID` — 이건 `list_sessions`·`send_message`가 받는
#   **바로 그 sessionId**다. 즉 트레일러를 읽으면 그 세션에 곧바로 메시지를 보낼 수 있다.
#   (`CLAUDE_CODE_SESSION_ID`는 내부 에이전트 id라 메시지를 못 보낸다 — 쓰지 말 것.)
#
# 설계 원칙:
#   · 환경변수가 없으면 **아무것도 하지 않는다**(유호님 손커밋·CI·다른 도구를 방해하지 않는다).
#   · 이미 트레일러가 있으면 덧붙이지 않는다(amend·rebase에서 중복 방지).
#   · 실패해도 커밋을 막지 않는다 — 귀속은 편의지 안전장치가 아니다. 여기서 커밋을 세우면
#     "기록을 도구 사정으로 멈추는" 쪽이 되고, 그게 오귀속보다 나쁘다(friction.js와 같은 판단).
#
# 정본은 이 파일(repo). `.git/hooks/`의 사본은 설치본이다 — 고칠 때는 여기를 고치고
# `node tools/install-githooks.js`로 다시 설치한다(tests/커밋트레일러.test.js가 드리프트를 잡는다).

MSG_FILE="$1"

[ -n "$MSG_FILE" ] || exit 0
[ -f "$MSG_FILE" ] || exit 0
[ -n "$CLAUDE_CODE_HOST_SESSION_ID" ] || exit 0

# 손으로 적어 둔 값이 **내 id 의 축약형**이면 교체한다 (마찰 F300, 2026-08-09 실사고).
#   `--if-exists doNothing` 은 틀린 값도 그대로 둔다. 실측: 커밋 메시지 파일 끝에
#   `Session-Id: local_c23ccb25`(보드 지문 8자리)를 손으로 적었더니 훅이 비켜서 그게 박혔고,
#   `track-collision` 이 즉시 「남의 커밋이 내 자리에 착지했다」고 알렸다 — 소유 판별은 전부
#   이 값을 **문자열 그대로** 비교하므로 축약형은 어떤 세션과도 안 맞는다(내 것이 남의 것이 된다).
#   보드 지문(8자리)과 이 트레일러(전체)는 서로 다른 식별자다 — 헷갈리기 쉬운 자리다.
#
# 🔑 **접두사일 때만** 교체한다. `--if-exists replace` 통째로는 안 된다 — cherry-pick 도 이 훅을
#   부르므로 원저자의 완전한 트레일러를 내 것으로 덮어쓴다. 남의 UUID 는 내 id 의 접두사가
#   아니므로 이 조건에 안 걸린다(회귀가 양쪽을 다 잰다).
EXISTING=$(git interpret-trailers --parse "$MSG_FILE" 2>/dev/null \
  | sed -n 's/^Session-Id:[[:space:]]*//p' | tail -1)

MODE=doNothing
if [ -n "$EXISTING" ] && [ "$EXISTING" != "$CLAUDE_CODE_HOST_SESSION_ID" ] \
   && [ "${CLAUDE_CODE_HOST_SESSION_ID#"$EXISTING"}" != "$CLAUDE_CODE_HOST_SESSION_ID" ]; then
  MODE=replace
fi

# git interpret-trailers를 쓴다 — 손으로 append하면 주석 블록·빈 줄 때문에 트레일러 문단이
# 갈라져 `%(trailers)`로 안 읽힌다(그러면 박아도 못 찾는 셈이라 목적이 통째로 무너진다).
git interpret-trailers --in-place \
  --if-exists "$MODE" \
  --trailer "Session-Id: $CLAUDE_CODE_HOST_SESSION_ID" \
  "$MSG_FILE" 2>/dev/null

exit 0
