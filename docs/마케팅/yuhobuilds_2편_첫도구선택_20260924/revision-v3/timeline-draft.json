      "segment": "08"
    },
    {
      "text": "한",
      "start": 36.402,
      "end": 36.5,
      "segment": "08"
    },
    {
      "text": "번도",
      "start": 36.537,
      "end": 36.672,
      "segment": "08"
    },
    {
      "text": "안",
      "start": 36.708999999999996,
      "end": 36.746,
      "segment": "08"
    },
    {
      "text": "찍었는데요!",
      "start": 36.783,
      "end": 37.385,
      "segment": "08"
    },
    {
      "text": "지금",
