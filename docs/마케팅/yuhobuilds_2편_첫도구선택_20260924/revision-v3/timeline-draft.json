      "start": 56.86033333333333,
      "end": 56.96033333333333,
      "segment": "12"
    },
    {
      "text": "질문을",
      "start": 56.96033333333333,
      "end": 57.17933333333333,
      "segment": "12"
    },
    {
      "text": "보내는",
      "start": 57.17933333333333,
      "end": 57.39833333333333,
      "segment": "12"
    },
    {
      "text": "데까지",
      "start": 57.39833333333333,
      "end": 57.617333333333335,
      "segment": "12"
    },
    {
      "text": "같이",
      "start": 57.617333333333335,
      "end": 57.763333333333335,
      "segment": "12"
    },
    {
      "text": "해볼게요.",
      "start": 57.763333333333335,
