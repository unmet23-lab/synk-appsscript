    },
    {
      "text": "헤맨",
      "start": 58.27433333333333,
      "end": 58.42033333333333,
      "segment": "12"
    },
    {
      "text": "길,",
      "start": 58.42033333333333,
      "end": 58.56633333333333,
      "segment": "12"
    },
    {
      "text": "여러분은",
      "start": 58.56633333333333,
      "end": 58.858333333333334,
      "segment": "12"
    },
    {
      "text": "건너뛰세요.",
