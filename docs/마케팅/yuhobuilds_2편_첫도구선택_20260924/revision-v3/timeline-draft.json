    },
    {
      "text": "다만",
      "start": 51.23666666666667,
      "end": 51.38266666666667,
      "segment": "11a"
    },
    {
      "text": "다른",
      "start": 51.38266666666667,
      "end": 51.52866666666667,
      "segment": "11a"
    },
    {
      "text": "AI의",
