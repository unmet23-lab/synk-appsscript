      "segment": "11b"
    },
    {
      "text": "기능에",
      "start": 54.90933333333333,
      "end": 55.12833333333333,
      "segment": "11b"
    },
    {
      "text": "맞는지",
      "start": 55.12833333333333,
      "end": 55.34733333333333,
