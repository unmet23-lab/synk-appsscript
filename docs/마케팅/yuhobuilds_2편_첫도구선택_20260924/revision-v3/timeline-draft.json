    },
    {
      "text": "따져",
      "start": 55.34733333333333,
      "end": 55.49333333333333,
      "segment": "11b"
    },
    {
      "text": "보고요.",
      "start": 55.49333333333333,
      "end": 55.785333333333334,
      "segment": "11b"
    },
    {
      "text": "다음",
      "start": 56.20333333333333,
      "end": 56.349333333333334,
      "segment": "12"
    },
    {
      "text": "편엔",
      "start": 56.349333333333334,
      "end": 56.495333333333335,
      "segment": "12"
    },
    {
      "text": "도구를",
