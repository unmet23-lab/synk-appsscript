    {
      "text": "아니고, 지금 따라 하기 쉬운",
      "start": 58.47366666666667,
      "end": 59.86366666666667,
      "segment": "11"
    },
    {
      "text": "방법입니다.",
      "start": 59.86366666666667,
      "end": 60.57666666666667,
      "segment": "11"
    },
    {
