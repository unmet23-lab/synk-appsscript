   "key": "37fce40a82b48d84e7210d997d3a9a9c",
   "words": 15
  },
  {
   "id": "h2",
   "text": "그런데 한 줄을 붙였더니, 아직 안 올렸다며 기다려요.",
   "dur": 2.596,
   "syllablesPerSec": 8.09,
