    "text": "도구를",
    "start": 58.13333333333333,
    "end": 58.391333333333336,
    "segment": "15a"
  },
  {
    "text": "켜고,",
    "start": 58.42933333333333,
    "end": 58.58433333333333,
    "segment": "15a"
  },
  {
    "text": "설정하는",
    "start": 58.970333333333336,
    "end": 59.30533333333334,
    "segment": "15a"
  },
  {
    "text": "것부터",
    "start": 59.34433333333333,
    "end": 59.550333333333334,
    "segment": "15a"
  },
  {
    "text": "같이",
    "start": 59.730333333333334,
    "end": 59.885333333333335,
    "segment": "15a"
  },
  {
    "text": "해볼게요.",
    "start": 59.92433333333334,
    "end": 60.413333333333334,
    "segment": "15a"
  },
  {
    "text": "초보였던",
    "start": 60.605666666666664,
    "end": 61.03966666666667,
    "segment": "16"
  },
  {
    "text": "제가",
    "start": 61.077666666666666,
    "end": 61.25066666666667,
    "segment": "16"
  },
  {
    "text": "이걸",
    "start": 61.54866666666667,
    "end": 61.69766666666667,
    "segment": "16"
  },
  {
    "text": "처음부터",
    "start": 61.73466666666667,
    "end": 62.09466666666667,
    "segment": "16"
  },
  {
    "text": "알았더라면,",
    "start": 62.14366666666667,
    "end": 62.528666666666666,
    "segment": "16"
  },
  {
    "text": "적어도",
    "start": 62.888666666666666,
    "end": 63.13666666666667,
    "segment": "16"
  },
  {
    "text": "백",
    "start": 63.19866666666667,
    "end": 63.31066666666667,
    "segment": "16"
  },
  {
    "text": "시간은",
    "start": 63.34766666666667,
    "end": 63.57066666666667,
    "segment": "16"
  },
  {
    "text": "아꼈을",
    "start": 63.60766666666667,
    "end": 63.84366666666667,
    "segment": "16"
  },
  {
    "text": "것",
    "start": 63.88066666666667,
    "end": 63.93066666666667,
    "segment": "16"
  },
  {
    "text": "같아요.",
    "start": 63.97966666666667,
    "end": 64.42666666666668,
    "segment": "16"
  },
  {
    "text": "제가",
    "start": 64.62100000000001,
    "end": 64.88000000000001,
    "segment": "17"
  },
  {
    "text": "헤맨",
    "start": 64.94500000000001,
    "end": 65.13900000000001,
    "segment": "17"
  },
  {
    "text": "길,",
    "start": 65.188,
    "end": 65.301,
    "segment": "17"
  },
  {
    "text": "여러분은",
    "start": 65.75500000000001,
    "end": 66.04700000000001,
    "segment": "17"
  },
  {
    "text": "건너뛰세요.",
    "start": 66.09500000000001,
    "end": 66.77600000000001,
    "segment": "17"
  },
  {
    "text": "왕초보에서",
    "start": 67.11233333333332,
    "end": 67.61333333333333,
    "segment": "18"
  },
  {
    "text": "일인",
    "start": 67.67233333333333,
    "end": 67.83433333333333,
    "segment": "18"
  },
  {
    "text": "기업가까지.",
    "start": 67.87833333333333,
    "end": 68.34933333333333,
    "segment": "18"
  },
  {
    "text": "여러분의",
    "start": 68.89433333333332,
    "end": 69.18933333333332,
    "segment": "18"
  },
  {
    "text": "시간을",
    "start": 69.23333333333333,
    "end": 69.46933333333332,
    "segment": "18"
  },
  {
    "text": "아껴드립니다!",
    "start": 69.64533333333333,
    "end": 70.27933333333333,
    "segment": "18"
  }
]
