  {
    "text": "싶어.",
    "start": 58.13666666666666,
    "end": 58.282666666666664,
    "segment": "13a"
  },
  {
    "text": "가장",
    "start": 58.69466666666667,
    "end": 58.93366666666667,
    "segment": "13a"
  },
  {
    "text": "효율적으로",
    "start": 58.986666666666665,
    "end": 59.45166666666667,
    "segment": "13a"
  },
  {
    "text": "만들",
    "start": 59.49166666666667,
    "end": 59.690666666666665,
    "segment": "13a"
  },
  {
    "text": "수",
    "start": 59.730666666666664,
    "end": 59.77066666666666,
    "segment": "13a"
  },
  {
    "text": "있는",
    "start": 59.81066666666667,
    "end": 59.943666666666665,
    "segment": "13a"
  },
  {
    "text": "로드맵을",
    "start": 59.99666666666666,
    "end": 60.32866666666666,
    "segment": "13a"
  },
  {
    "text": "추천해",
    "start": 60.36866666666666,
    "end": 60.58166666666666,
    "segment": "13a"
  },
  {
    "text": "줘.",
    "start": 60.62166666666666,
    "end": 60.96666666666667,
    "segment": "13a"
  },
  {
    "text": "여러분도",
    "start": 61.218333333333334,
    "end": 61.538333333333334,
    "segment": "14"
  },
  {
    "text": "불편한",
    "start": 61.64033333333333,
    "end": 62.032333333333334,
    "segment": "14"
  },
  {
    "text": "일",
    "start": 62.07633333333333,
    "end": 62.10533333333333,
    "segment": "14"
  },
  {
    "text": "하나만",
    "start": 62.14933333333333,
    "end": 62.38133333333333,
    "segment": "14"
  },
  {
    "text": "골라보세요.",
    "start": 62.42533333333333,
    "end": 62.83233333333333,
    "segment": "14"
  },
  {
    "text": "거창한",
    "start": 63.35533333333333,
    "end": 63.70433333333333,
    "segment": "14"
  },
  {
    "text": "아이디어",
    "start": 63.74833333333333,
    "end": 63.96633333333333,
    "segment": "14"
  },
  {
    "text": "없어도,",
    "start": 64.00933333333333,
    "end": 64.24233333333333,
    "segment": "14"
  },
  {
    "text": "시작은",
    "start": 64.60533333333333,
    "end": 64.92533333333334,
    "segment": "14"
  },
  {
    "text": "거기서",
    "start": 64.99833333333333,
    "end": 65.24533333333333,
    "segment": "14"
  },
  {
    "text": "됩니다.",
    "start": 65.28933333333333,
    "end": 65.71033333333334,
    "segment": "14"
  },
  {
    "text": "다음",
    "start": 65.92266666666667,
    "end": 66.08966666666667,
    "segment": "15a"
  },
  {
    "text": "편에서는",
    "start": 66.12866666666667,
    "end": 66.47666666666667,
    "segment": "15a"
  },
  {
    "text": "도구를",
    "start": 66.56666666666668,
    "end": 66.82466666666667,
    "segment": "15a"
  },
  {
    "text": "켜고,",
    "start": 66.86266666666667,
    "end": 67.01766666666667,
    "segment": "15a"
  },
  {
    "text": "설정하는",
    "start": 67.40366666666667,
    "end": 67.73866666666667,
    "segment": "15a"
  },
  {
    "text": "것부터",
    "start": 67.77766666666668,
    "end": 67.98366666666668,
    "segment": "15a"
  },
  {
    "text": "같이",
    "start": 68.16366666666667,
    "end": 68.31866666666667,
    "segment": "15a"
  },
  {
    "text": "해볼게요.",
    "start": 68.35766666666667,
    "end": 68.84666666666668,
    "segment": "15a"
  },
  {
    "text": "제가",
    "start": 69.02100000000002,
    "end": 69.28000000000002,
    "segment": "17"
  },
  {
    "text": "헤맨",
    "start": 69.34500000000001,
    "end": 69.53900000000002,
    "segment": "17"
  },
  {
    "text": "길,",
    "start": 69.58800000000001,
    "end": 69.70100000000001,
    "segment": "17"
  },
  {
    "text": "여러분은",
    "start": 70.15500000000002,
    "end": 70.44700000000002,
    "segment": "17"
  },
  {
    "text": "건너뛰세요.",
    "start": 70.49500000000002,
    "end": 71.17600000000002,
    "segment": "17"
  },
  {
    "text": "왕초보에서",
    "start": 71.51233333333333,
    "end": 72.01333333333334,
    "segment": "18"
  },
  {
    "text": "일인",
    "start": 72.07233333333333,
    "end": 72.23433333333334,
    "segment": "18"
  },
  {
    "text": "기업가까지.",
    "start": 72.27833333333334,
    "end": 72.74933333333334,
    "segment": "18"
  },
  {
    "text": "여러분의",
    "start": 73.29433333333333,
    "end": 73.58933333333333,
    "segment": "18"
  },
  {
    "text": "시간을",
    "start": 73.63333333333334,
    "end": 73.86933333333333,
    "segment": "18"
  },
  {
    "text": "아껴드립니다!",
    "start": 74.04533333333333,
    "end": 74.67933333333333,
    "segment": "18"
  }
]
