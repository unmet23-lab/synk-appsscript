{
  "fps": 30,
  "durationInFrames": 2213,
  "audioFile": "yuho-journey-01/narration.wav",
  "audioStartFrame": 0,
  "scenes": [
    {
      "id": "01",
      "start": 0,
      "duration": 107,
      "visual": "hook",
      "text": "오늘은 번역 좀 하려고 결제했다가, 출석 앱까지 만들게 된 얘기예요.",
      "voiceStartFrame": 3,
      "voiceDurationSeconds": 3.387098
    },
    {
      "id": "02",
      "start": 107,
      "duration": 125,
      "visual": "setting",
      "text": "몽골 울란바토르, 학원 부원장. 친구도 없고, 솔직히 심심했습니다.",
      "voiceStartFrame": 108,
      "voiceDurationSeconds": 4.057392
    },
    {
      "id": "03",
      "start": 232,
      "duration": 109,
      "visual": "payment",
      "text": "유월 이일, 클로드 첫 결제! 그때는 딱 번역만 하려고 했죠.",
      "voiceStartFrame": 233,
      "voiceDurationSeconds": 3.52
    },
    {
      "id": "04",
      "start": 341,
      "duration": 108,
      "visual": "inquiries",
      "text": "그런데 학생 문의가 확 늘었어요. 잠깐, 이러면 관리가 어렵겠는데?",
      "voiceStartFrame": 342,
      "voiceDurationSeconds": 3.48
    },
    {
      "id": "05",
      "start": 449,
      "duration": 119,
      "visual": "purpose",
      "text": "출석 앱을 만들면? 부모님께 등하원 알림도 가고, 선생님들도 편해지잖아요!",
      "voiceStartFrame": 450,
      "voiceDurationSeconds": 3.850476
    },
    {
      "id": "06",
      "start": 568,
      "duration": 117,
      "visual": "tools",
      "text": "그래서 글라이드랑 구글 시트로 앱 만들기 시작! 그런데 제 개발 실력은?",
      "voiceStartFrame": 569,
      "voiceDurationSeconds": 3.790317
    },
    {
      "id": "07",
      "start": 685,
      "duration": 111,
      "visual": "zero",
      "text": "제로. 클로드 코드가 뭔지도 몰랐어요. 설정부터 막혔죠.",
      "voiceStartFrame": 686,
      "voiceDurationSeconds": 3.583356
    },
    {
      "id": "08",
      "start": 796,
      "duration": 77,
      "visual": "screenshots",
      "text": "방법은 하나. 화면 찍고! 물어보고! 따라 하고!",
      "voiceStartFrame": 797,
      "voiceDurationSeconds": 2.460952
    },
    {
      "id": "09",
      "start": 873,
      "duration": 111,
      "visual": "loop",
      "text": "오, 다음 화면! 근데 이건 또 뭐야? 다시 찍고, 다시 질문!",
      "voiceStartFrame": 874,
      "voiceDurationSeconds": 3.593764
    },
    {
      "id": "10",
      "start": 984,
      "duration": 106,
      "visual": "hours",
      "text": "수업 시간 빼고, 하루 열일곱, 열여덟 시간은 붙잡았던 것 같아요.",
      "voiceStartFrame": 985,
      "voiceDurationSeconds": 3.44
    },
    {
      "id": "11b",
      "start": 1090,
      "duration": 222,
      "visual": "joke",
      "text": "심심함은 해결됐습니다. 앱은요? 몇 번을 뜯어고쳤는지 깊은 한숨이 잦았답니다. 실제로 탈모 걸린 거 아닌지 가끔 머리를 만져봤어요.",
      "voiceStartFrame": 1091,
      "voiceDurationSeconds": 7.13
    },
    {
      "id": "12",
      "start": 1312,
      "duration": 119,
      "visual": "lesson",
      "text": "지금 다시 시작하면, 처음부터 다 만들진 않을 거예요. 딱 출석 하나부터!",
      "voiceStartFrame": 1313,
      "voiceDurationSeconds": 3.852472
    },
    {
      "id": "13a",
      "start": 1431,
      "duration": 230,
      "visual": "prompt",
      "text": "만들고 싶은 걸 넣고, 이렇게 물어보세요. 나는 개발이 처음이야. 학원 출석 앱을 만들고 싶어. 가장 효율적으로 만들 수 있는 로드맵을 추천해 줘.",
      "voiceStartFrame": 1432,
      "voiceDurationSeconds": 7.56
    },
    {
      "id": "14",
      "start": 1661,
      "duration": 142,
      "visual": "action",
      "text": "여러분도 불편한 일 하나만 골라보세요. 거창한 아이디어 없어도, 시작은 거기서 됩니다.",
      "voiceStartFrame": 1662,
      "voiceDurationSeconds": 4.637098
    },
    {
      "id": "15a",
      "start": 1803,
      "duration": 94,
      "visual": "ending",
      "text": "다음 편에서는 도구를 켜고, 설정하는 것부터 같이 해볼게요.",
      "voiceStartFrame": 1804,
      "voiceDurationSeconds": 3.04
    },
    {
      "id": "16",
      "start": 1897,
      "duration": 121,
      "visual": "timesaved",
      "text": "초보였던 제가 이걸 처음부터 알았더라면, 적어도 100시간은 아꼈을 것 같아요.",
      "voiceStartFrame": 1898,
      "voiceDurationSeconds": 3.92
    },
    {
      "id": "17",
      "start": 2018,
      "duration": 70,
      "visual": "shortcut",
      "text": "제가 헤맨 길, 여러분은 건너뛰세요.",
      "voiceStartFrame": 2019,
      "voiceDurationSeconds": 2.235782
    },
    {
      "id": "18",
      "start": 2088,
      "duration": 125,
      "visual": "signoff",
      "text": "왕초보에서 1인 기업가까지. 여러분의 시간을 아껴드립니다!",
      "voiceStartFrame": 2095,
      "voiceDurationSeconds": 3.225828
    }
  ]
}
