{
  "about": "EP01 화면 자막 원고(목소리와 무관). 낱말은 띄어쓰기로 나눈다. *별표*로 감싼 낱말이 강조(계정색)다. 자막 한 줄에 강조 한 곳. hide=true는 자막 띠에 띄우지 않고 화면 안(질문 창 타이핑)에서 같은 낱말 시각으로 보여 준다. seg는 revision-v2 timing.json의 구간 번호(임시 음성에서만 쓴다). 화면 표기는 6월·1인, 합성 발음은 유월·일인이었다.",
  "captions": [
    { "id": "c01", "seg": "01", "text": "오늘은 AI로 *출석 앱* 만들다," },
    { "id": "c02", "seg": "01", "text": "정작 출석을 *까먹은* 얘깁니다." },
    { "id": "c03", "seg": "02", "text": "이 *한 줄부터* 정했다면, 덜 헤맸을 거예요." },
    { "id": "c04", "seg": "03", "text": "몽골 학원에서 일하던 *6월.*" },
    { "id": "c05", "seg": "03", "text": "번역하려고 *클로드를* 결제했어요." },
    { "id": "c06", "seg": "04", "text": "학생 문의가 늘자, *출석 앱도* 만들고 싶어졌죠." },
    { "id": "c07", "seg": "05", "text": "문제는, 개발을 *하나도* 몰랐다는 거." },
    { "id": "c08", "seg": "06", "text": "*화면* 찍고, 물어보고," },
    { "id": "c09", "seg": "06", "text": "*그대로* 따라 했습니다." },
    { "id": "c10", "seg": "07", "text": "그런데 *이 기능도* 좋아 보이고," },
    { "id": "c11", "seg": "07", "text": "*저것도* 넣고 싶고." },
    { "id": "c12", "seg": "08", "text": "*기능은* 늘었는데," },
    { "id": "c13", "seg": "08", "text": "정작 출석은 *뒷전.*" },
    { "id": "c14", "seg": "08", "text": "나 *뭐* 만들고 있었지?" },
    { "id": "c15", "seg": "09", "text": "*지금* 다시 한다면," },
    { "id": "c16", "seg": "09", "text": "*완성의 기준부터* 한 줄로 정하겠어요." },
    { "id": "c17", "seg": "10", "text": "학생 한 명의 출석을 *저장하고,*" },
    { "id": "c18", "seg": "10", "text": "다시 *확인할* 수 있게." },
    { "id": "c19", "seg": "11", "text": "*화면으로* 볼게요." },
    { "id": "c20", "seg": "11", "text": "이름을 고르고, *출석 저장.*" },
    { "id": "c21", "seg": "12", "text": "목록에 *남았죠?* 다시 열어도 기록이 보이면," },
    { "id": "c22", "seg": "12", "text": "*첫 단계 완료!*" },
    { "id": "c23", "seg": "13", "text": "AI에게는 *이렇게* 말해보세요." },
    { "id": "c24", "seg": "13", "text": "나는 개발이 *처음이야.*", "hide": true },
    { "id": "c25", "seg": "14", "text": "학생 한 명의 출석을 *저장하고,* 다시 확인하고 싶어.", "hide": true },
    { "id": "c26", "seg": "15", "text": "추가 기능은 *빼고,*", "hide": true },
    { "id": "c27", "seg": "15", "text": "가장 쉬운 방법과 확인 순서를 알려줘.", "hide": true },
    { "id": "c28", "seg": "16", "text": "*작게 완성하고,* 확인한 뒤, 다음 기능." },
    { "id": "c29", "seg": "16", "text": "*순서가* 생겼죠?" },
    { "id": "c30", "seg": "17", "text": "제가 헤맨 길, 여러분은 *건너뛰세요.*" },
    { "id": "c31", "seg": "18", "text": "왕초보에서 *1인 기업가까지.*" },
    { "id": "c32", "seg": "18", "text": "여러분의 *시간을* 아껴드립니다!" }
  ]
}
