  "lines": [
    { "id": "u1", "seg": "project-reuse", "from": 5, "to": 10, "scene": "s1", "text": "정리 규칙을 *한 번* 저장하면," },
    { "id": "u2", "seg": "project-reuse", "from": 10, "to": 17, "scene": "s2", "gap": 0.36, "text": "다음 회의는 새 채팅에 *기록만* 넣으면 돼요." },
    { "id": "h", "seg": "project", "from": 0, "to": 7, "scene": "s3", "gap": 0.32, "text": "매번 같은 부탁을 쓰기 번거롭죠? *프로젝트를* 써보세요." },
    { "id": "d", "seg": "project", "from": 7, "to": 17, "scene": "s4", "gap": 0.2, "text": "같은 업무의 대화, 자료, 규칙을 모아두는 *전용 폴더* 같은 공간이에요." },
    { "id": "c1", "seg": "create", "from": 0, "to": 5, "scene": "s5", "gap": 0.36, "text": "왼쪽 프로젝트에서 *새 프로젝트를* 눌러요." },
    { "id": "c2", "seg": "create", "from": 5, "to": 11, "scene": "s6", "text": "이름을 *회의 정리로* 적고, 만들기를 누르세요." },
    { "id": "g", "seg": "settings", "from": 0, "to": 9, "scene": "s7", "gap": 0.2, "text": "회의 프로젝트의 점 세 개를 누르고, *프로젝트 설정을* 여세요." },
    { "id": "v1", "seg": "save", "from": 0, "to": 5, "scene": "s8", "text": "가이드에서 프로젝트에 저장할 *규칙을* 복사해요." },
    { "id": "v2", "seg": "save", "from": 5, "to": 12, "scene": "s9", "text": "*지침 입력란에* 붙여넣고, 오른쪽 아래 저장을 누르세요." },
    { "id": "w1", "seg": "global", "from": 0, "to": 8, "scene": "s10", "gap": 0.36, "text": "이 회의 규칙은 *계정 전체* 지침에 넣지 마세요." },
    { "id": "w2", "seg": "global", "from": 8, "to": 16, "scene": "s11", "gap": 0.2, "text": "여행 질문이나 다른 글쓰기에도 *영향을* 줄 수 있어요." },
    { "id": "n1", "seg": "repeat-send", "from": 0, "to": 6, "scene": "s12", "gap": 0.32, "text": "이제 *이번 회의도 정리해줘,* 라고 쓰고," },
    { "id": "n2", "seg": "repeat-send", "from": 6, "to": 14, "scene": "s13", "gap": 0.2, "text": "오늘 적은 메모나 녹음을 글로 옮긴 내용을 *붙여넣으세요.*" },
    { "id": "n3", "seg": "repeat-send", "from": 14, "to": 18, "scene": "s14", "text": "오른쪽 화살표를 누르면 *끝이에요.*" },
    { "id": "e1", "seg": "ending-follow", "from": 0, "to": 8, "scene": "s15", "gap": 0.32, "text": "따라 할 PDF와 복사용 문장, *연습 메모까지* 준비했어요." }
  ],
