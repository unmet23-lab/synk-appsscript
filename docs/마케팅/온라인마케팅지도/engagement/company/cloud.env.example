# Preparation only. Copy to /etc/synk/company.env on the approved Linux host;
# chmod 600; never commit the real file. No provider is enabled by this example.
SYNK_COMPANY_DOMAIN=
SYNK_TLS_EMAIL=
SYNK_COMPANY_IMAGE=
COMPANY_VOLUME_DIR=/srv/synk/company
COMPANY_BACKUP_DIR=/srv/synk/backups
# Host root:root 0700 only; never mount this archive directory into containers.
COMPANY_ARCHIVE_DIR=/srv/synk/backup-archives
CADDY_DATA_DIR=/srv/synk/caddy-data
CADDY_CONFIG_DIR=/srv/synk/caddy-config
SYNK_COMPANY_REQUIRE_EXISTING_DATA=1
# Keep restored collection, reminder and Drive deletion queues paused until accepted.
# Only 0/1 are valid. Authentication/session revocation checks remain active.
SYNK_COMPANY_BACKGROUND_JOBS_ENABLED=0
# Personal reminders and daily due digests only. Keep collection and Drive deletion
# paused while enabling accepted work notifications. If omitted, inherits BACKGROUND.
SYNK_COMPANY_WORK_NOTIFICATIONS_ENABLED=0
# Explicit opt-in per browser, HTTPS only. Enable after deployment acceptance.
# This worker is independent of BACKGROUND_JOBS_ENABLED; enabling it must not
# resume collection, Drive deletion, reminders or due digests. VAPID keys are
# generated once in encrypted company credentials; preserve the DB and its key.
SYNK_COMPANY_WEB_PUSH_ENABLED=0
SYNK_PLATFORM_URL=https://synk.im

# PULSE receipt import reads verified receiver/sync.cjs output only. On Linux,
# place that complete inbox copy under COMPANY_VOLUME_DIR/pulse-inbox on the host;
# the existing /data bind mount exposes it here. This does not run Drive sync.
# Imported originals are then copied into /data/studio-media and backed up.
SYNK_PULSE_INBOX=/data/pulse-inbox

# Existing STAFF client. Only invited, linked active company users can enter.
SYNK_ID_ACCOUNT_API_URL=
SYNK_ID_PUBLISHABLE_KEY=
SYNK_ID_SUPABASE_URL=
SYNK_ID_MESSENGER_CLIENT_ID=

# Separate CUSTOMER platform client, with exact callback registered centrally:
# https://YOUR_HOST/api/customer/synk-id/callback
# Leave all five empty until registration is complete. No employee client reuse.
SYNK_ID_CUSTOMER_ACCOUNT_API_URL=
SYNK_ID_CUSTOMER_PUBLISHABLE_KEY=
SYNK_ID_CUSTOMER_SUPABASE_URL=
SYNK_ID_CUSTOMER_CLIENT_ID=
SYNK_ID_CUSTOMER_REDIRECT_URI=

# Current computer extraction adapter is OpenAI. Google Cloud credits cannot
# pay this endpoint. No model switch, paid smoke call or budget increase implied.
SYNK_COMPUTER_AI_ENABLED=0
SYNK_COMPUTER_AI_CUSTOMER_ENABLED=0
SYNK_COMPUTER_AI_MODEL=gpt-6-luna
OPENAI_API_KEY=
SYNK_COMPUTER_AI_MAX_OUTPUT_TOKENS=
SYNK_COMPUTER_AI_INPUT_PER_MILLION_MICRO_USD=
SYNK_COMPUTER_AI_OUTPUT_PER_MILLION_MICRO_USD=
SYNK_COMPUTER_AI_REQUEST_LIMIT_MICRO_USD=
SYNK_COMPUTER_AI_TOTAL_LIMIT_MICRO_USD=
SYNK_COMPUTER_AI_CUSTOMER_DAILY_REQUESTS=
SYNK_COMPUTER_AI_CUSTOMER_DAILY_MICRO_USD=

# Private off-host backup destination and least-privilege VM service account
# must be configured and a restore verified before this is enabled.
SYNK_BACKUP_UPLOAD_ENABLED=0
SYNK_BACKUP_GCS_DESTINATION=
