[Unit]
Description=SYNK completed workspace snapshot to private backup storage
Requisite=synk-company.service
After=synk-company.service
PartOf=synk-company.service

[Service]
Type=oneshot
EnvironmentFile=/etc/synk/company.env
StateDirectory=synk-company-ops
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/bash /opt/synk/current/docs/마케팅/온라인마케팅지도/engagement/company/deploy/company-backup.sh
TimeoutStartSec=45min
