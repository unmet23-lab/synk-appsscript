{
    email {$SYNK_TLS_EMAIL}
    # A media grant is a temporary bearer credential. Redact runtime error logs.
    log default {
        format filter {
            wrap json
            fields {
                request>uri regexp ^/social-publish-media/.*$ /social-publish-media/REDACTED
            }
        }
    }
    # The production load balancer publishes TCP only, so HTTP/3 is unavailable.
    servers {
        protocols h1 h2
    }
}

{$SYNK_COMPANY_DOMAIN} {
    # Keep capability URLs out of access logs if access logging is enabled later.
    log_skip /social-publish-media/*
    # Preserve the public Host for company origin/session validation.
    header Strict-Transport-Security "max-age=31536000"
    # Invalidate the earlier HTTP/3 advertisement cached by returning browsers.
    header >Alt-Svc clear

    # Work-backup provisioning server (experiences/solo-backup-rust/server/README.md). It runs
    # on the writer node as host services, not containers, and its api listens on the wb-front
    # bridge's host address; only this Caddy shares that network. While it is down this path
    # answers 502 and every other path is unchanged. The api strips /backup-api itself.
    handle /backup-api/* {
        request_body {
            max_size 1MB
        }
        reverse_proxy 172.30.77.9:4210 {
            header_up X-Forwarded-For {remote_host}
        }
    }

    reverse_proxy company:4191 {
        # Caddy is the only public entry; discard client-supplied forwarding.
        header_up X-Forwarded-For {remote_host}
    }
}
