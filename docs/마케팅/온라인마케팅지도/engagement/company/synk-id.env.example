# Public integration settings only. This example does not configure a running server.
# Central endpoint accepts only a registered messenger OAuth client and active SYNK identity.
SYNK_ID_ACCOUNT_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/synk-account
SYNK_ID_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Browser/mobile server-side PKCE. Register exactly https://COMPANY_HOST/api/synk-id/callback
# (loopback development callback must also be explicitly registered with the identity provider).
SYNK_ID_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SYNK_ID_MESSENGER_CLIENT_ID=YOUR_REGISTERED_MESSENGER_BROWSER_CLIENT_ID
# Optional web preview navigation. An empty value hides the link even on localhost.
SYNK_PLATFORM_URL=
