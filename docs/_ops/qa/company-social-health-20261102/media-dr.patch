+'use strict';
+const HELPER_SHA='851dc81d9ce06105e176717c5cf1685e981a176b4d1e26c623dbb3a0121b3b05';
+function validate(p){
+  const need=(value,code)=>{if(!value)throw Error(code);};
+  need(p?.schema==='synk-ha-dr-media-hydration/v1'&&p.helperSha256===HELPER_SHA&&/^[a-f0-9]{64}$/.test(p.manifestSha256)&&p.privateDerivedOnly===true,'REVIEWED_PRIVATE_MEDIA_PROOF_REQUIRED');
+  need(['archive-bytes','manifest-hydrated'].includes(p.mode),'MEDIA_PROOF_MODE');
+  for(const name of ['files','contents','logicalBytes','contentBytes'])need(Number.isSafeInteger(p[name])&&p[name]>=0,'MEDIA_PROOF_COUNTS');
+  need(p.contents<=p.files&&p.contentBytes<=p.logicalBytes&&((p.files===0)===(p.contents===0))&&(p.files!==0||(p.logicalBytes===0&&p.contentBytes===0)),'MEDIA_PROOF_COUNT_RELATION');
+  if(p.mode==='manifest-hydrated')need(p.bucket==='synk-company-backups-931078180935'&&p.prefix==='company/production/'&&p.fromOtherBackups===0,'MEDIA_PROOF_SOURCE_SCOPE');
+  return p;
+}
+module.exports={validate,HELPER_SHA};
