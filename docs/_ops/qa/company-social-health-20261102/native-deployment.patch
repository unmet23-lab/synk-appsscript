+        n.command={};n.recovery=False;n.held=10;n.ops=11;n.saved={'initialContainers':{'/synk-company-company-1':{'id':'a'*64,'image':'sha256:'+'b'*64}}}
+        rows=[{'Name':'/synk-company-company-1','Id':'a'*64,'Image':'sha256:'+'b'*64,'State':{'Running':True,'Restarting':False}}];calls=[]
+        n.fresh=lambda *a:{'bootAllowed':[],'readyAllowed':[]};n.raw_containers=lambda:rows
+        def run(args,timeout):calls.append(args);rows[0]['State']['Running']=False
+        n.w=type('W',(),{'joined_run':staticmethod(run)})();return n,rows,calls
+    def test_stop_pinned_writer_before_agent_and_keep_full_stop_verification(self):
+        n,rows,calls=self.fixture();n.lock=lambda:None;n.node=lambda:{}
+        n.h=type('H',(),{'stop_stack':staticmethod(lambda node:calls.append('full-stop') or {'containerStopConfirmed':True})})();n.stopped_gate=lambda:calls.append('stopped-gate')
+        out=n.execute('STOP',{},False)
+        self.assertEqual(calls,[['docker','stop','--time','60','a'*64],['systemctl','stop','synk-ha-node.service'],'full-stop','stopped-gate']);self.assertTrue(out['writersStopped'])
+    def test_no_container_action_for_standby_or_other_job_modes(self):
+        for change in ('standby','same-release-noop','dr-helper-only','recovery'):
+            n,rows,calls=self.fixture()
+            if change=='standby':n.n=h.IDS['standby']
+            elif change=='recovery':n.recovery=True;rows[0]['Id']='c'*64
+            else:n.c['mode']=change
+            n.close_company_streams();self.assertEqual(calls,[])
+    def test_revoked_boot_and_both_locks_are_required(self):
+        for change in ('boot','ready','lock','ops'):
+            n,rows,calls=self.fixture()
+            if change=='boot':n.fresh=lambda *a:{'bootAllowed':[n.n],'readyAllowed':[]}
+            if change=='ready':n.fresh=lambda *a:{'bootAllowed':[],'readyAllowed':[n.n]}
+            if change=='lock':n.held=None
+            if change=='ops':n.ops=None
+            with self.assertRaisesRegex(h.Hold,'STREAM_STOP_AUTHORITY'):n.close_company_streams()
+            self.assertEqual(calls,[])
+    def test_replaced_or_missing_captured_container_is_rejected_without_stop(self):
+        for change in ('id','image','missing','capture'):
+            n,rows,calls=self.fixture()
+            if change=='id':rows[0]['Id']='c'*64
+            if change=='image':rows[0]['Image']='sha256:'+'c'*64
+            if change=='missing':rows.clear()
+            if change=='capture':n.saved={}
+            with self.assertRaisesRegex(h.Hold,'STREAM_STOP_'):n.close_company_streams()
+            self.assertEqual(calls,[])
+    def test_authority_loss_or_running_writer_after_stop_never_passes(self):
