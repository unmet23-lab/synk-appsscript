  "reviewRepairs": [
    "A terminal retry/checkpoint failure releases pending input locks after its delivery record is cleared",
    "Suspended accounts are not prompted to resume initial setup",
    "Legacy incomplete documents acquire an explicit confirmation marker on their first new mutation"
  ],
  "limitations": [
    "Unsent drafts remain in tab memory only and do not survive reload or tab closure; only the receipt lookup is persisted",
    "Legacy completed accounts without the new confirmation marker keep their prior compatibility state; historical all-off intent is not inferred as newly confirmed",
    "Synthetic local checks do not verify real user satisfaction, physical devices, real identity providers or deployment",
    "Paid AI, model evaluation, tutor and participant recruitment remain deferred"
  ]
}
