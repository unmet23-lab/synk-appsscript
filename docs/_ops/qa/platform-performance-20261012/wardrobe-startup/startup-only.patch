+  try{
+    const loading=(async()=>{
+      const response=await fetch(new URL('./assets/wardrobe-environment-v1.bin.gz',import.meta.url),{signal:request.signal});
+      if(!response.ok)throw Error('WARDROBE_ENVIRONMENT_ASSET');
+      request.signal.throwIfAborted();
