  "reviewRepairs": [
    "Only the profile scopes being submitted are locked during a slow save, preventing post-submit input loss",
    "Public custom expiration controls become editable again after busy renders",
    "Existing concurrency fixture now changes the public value; a separate new case preserves drafts when only revision changes and requires fresh confirmation"
  ],
  "limitations": [
    "Draft protection covers the settings introduction editor and public-answer rows, not the initial onboarding form",
    "Raw drafts live only in tab memory and disappear on reload, tab close or scope invalidation",
    "Synthetic local checks do not verify real user satisfaction, physical devices, real identity providers or deployment",
    "Paid AI, model evaluation, tutor and participant recruitment remain deferred"
  ]
}
