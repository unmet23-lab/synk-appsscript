+"""Fault-injected GET transport checks. No real network or service actions."""
+import contextlib,importlib.util,json,pathlib,types,unittest,urllib.error
+from unittest.mock import patch
+
+def load(name,file):
+ spec=importlib.util.spec_from_file_location(name,pathlib.Path(__file__).with_name(file));module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module);return module
+h=load('retry_host','deployment-host.py');w=load('retry_worker','maintenance-entry-worker.py');n=load('retry_release','release-node.py')
+URL='https://storage.googleapis.com/storage/v1/b/example/o/state'
+class Worker:
+ def meta(self,p):return {'project/project-id':h.PROJECT.encode(),'instance/id':h.IDS['primary'].encode(),'instance/service-accounts/default/token':b'{"token_type":"Bearer","access_token":"synthetic-only","expires_in":300}'}[p]
+class Response:
+ status=200;headers={'Metadata-Flavor':'Google'}
+ def __init__(self,body=b'{"ok":true}',error=None,read_elapsed=0):self.body=body;self.error=error;self.read_elapsed=read_elapsed;self.closed=False
+ def __enter__(self):return self
+ def __exit__(self,*args):self.closed=True
+ def read(self,size):
+  self.clock.now+=self.read_elapsed
+  if self.error:raise self.error
+  return self.body[:size]
+class Harness:
+ def __init__(self,kind,actions):self.kind=kind;self.module={'host':h,'worker':w,'release':n}[kind];self.actions=list(actions);self.calls=[];self.sleeps=[];self.now=100;self.cloud=h.Cloud(h.IDS['primary'],Worker())
+ def open(self,req,timeout):
+  self.calls.append({'url':req.full_url,'headers':dict(req.header_items()),'method':req.get_method(),'data':req.data,'timeout':timeout});action=self.actions.pop(0)
+  if isinstance(action,tuple):elapsed,action=action;self.now+=elapsed
+  if isinstance(action,BaseException):raise action
+  action.clock=self;return action
+ def sleep(self,delay):self.sleeps.append(delay);self.now+=delay
+ def __enter__(self):
+  self.ctx=contextlib.ExitStack();self.ctx.enter_context(patch.object(self.module.urllib.request,'build_opener',return_value=self));self.ctx.enter_context(patch.object(self.module.time,'monotonic',lambda:self.now));self.ctx.enter_context(patch.object(self.module.time,'sleep',self.sleep));return self
+ def __exit__(self,*args):self.ctx.close()
+ def call(self,method='GET',body=None):return self.cloud.request(URL,method,body) if self.kind=='host' else self.module.fetch(URL,{'Authorization':'Bearer synthetic-only'})
+
+class ReadRetryTests(unittest.TestCase):
+ def kinds(self):return ('host','worker','release')
+ def test_timeout_retries_identical_read_then_succeeds(self):
+  for kind in self.kinds():
+   with self.subTest(kind=kind),Harness(kind,[TimeoutError(),Response()]) as x:
+    x.call();self.assertEqual(len(x.calls),2);self.assertEqual({k:v for k,v in x.calls[0].items() if k!='timeout'},{k:v for k,v in x.calls[1].items() if k!='timeout'});self.assertEqual(x.sleeps,[.25])
+ def test_ten_second_timeout_leaves_only_original_remaining_budget(self):
+  for kind in self.kinds():
+   with self.subTest(kind=kind),Harness(kind,[(10,TimeoutError()),Response()]) as x:x.call();self.assertEqual([c['timeout'] for c in x.calls],[10,3.75]);self.assertEqual(x.now,110.25)
+ def test_reset_and_wrapped_timeout_can_recover(self):
+  for kind in self.kinds():
+   with self.subTest(kind=kind),Harness(kind,[ConnectionResetError(),urllib.error.URLError(TimeoutError()),Response()]) as x:x.call();self.assertEqual(len(x.calls),3);self.assertEqual(x.sleeps,[.25,.5])
+ def test_three_failures_fail_closed_without_leaking_error_text(self):
+  for kind in self.kinds():
+   with self.subTest(kind=kind),Harness(kind,[TimeoutError('private-value') for _ in range(3)]) as x:
+    with self.assertRaisesRegex(x.module.Hold,'GET_TIMEOUT_EXHAUSTED$') as result:x.call()
+    self.assertNotIn('private-value',str(result.exception));self.assertEqual(len(x.calls),3)
+ def test_original_budget_is_not_reset_after_slow_failure(self):
+  for kind in self.kinds():
+   with self.subTest(kind=kind),Harness(kind,[(13.8,TimeoutError())]) as x:
+    with self.assertRaisesRegex(x.module.Hold,'EXHAUSTED$'):x.call()
+    self.assertEqual(len(x.calls),1);self.assertEqual(x.sleeps,[])
+ def test_late_success_is_rejected_and_response_closed(self):
+  for kind in self.kinds():
+   response=Response(read_elapsed=15)
+   with self.subTest(kind=kind),Harness(kind,[response]) as x:
+    with self.assertRaisesRegex(x.module.Hold,'GET_BUDGET_EXHAUSTED$'):x.call()
+    self.assertEqual(len(x.calls),1);self.assertTrue(response.closed)
+ def test_response_body_timeout_reissues_same_get(self):
+  for kind in self.kinds():
+   response=Response(error=TimeoutError())
+   with self.subTest(kind=kind),Harness(kind,[response,Response()]) as x:x.call();self.assertTrue(response.closed);self.assertEqual(len(x.calls),2)
+ def test_only_selected_transient_http_statuses_retry(self):
+  for kind in self.kinds():
+   for code in (429,502,503,504):
+    with self.subTest(kind=kind,code=code),Harness(kind,[urllib.error.HTTPError(URL,code,'synthetic',{},None),Response()]) as x:x.call();self.assertEqual(len(x.calls),2)
+ def test_auth_and_other_http_errors_are_never_retried(self):
+  for kind in self.kinds():
+   for code in (401,403,500):
+    with self.subTest(kind=kind,code=code),Harness(kind,[urllib.error.HTTPError(URL,code,'synthetic',{},None)]) as x:
+     with self.assertRaises((x.module.Hold,urllib.error.HTTPError)):x.call()
+     self.assertEqual(len(x.calls),1)
+ def test_dns_tls_and_unknown_urlerror_reasons_are_not_retried(self):
+  for kind in self.kinds():
+   for reason in ('timed out',OSError('dns'),ConnectionAbortedError()):
+    with self.subTest(kind=kind,reason=type(reason).__name__),Harness(kind,[urllib.error.URLError(reason)]) as x:
+     with self.assertRaises(urllib.error.URLError):x.call()
+     self.assertEqual(len(x.calls),1)
+ def test_body_size_bound_is_unchanged(self):
+  for kind in self.kinds():
+   with self.subTest(kind=kind),Harness(kind,[Response(b'x'*1048577)]) as x:
+    with self.assertRaises(x.module.Hold):x.call()
+    self.assertEqual(len(x.calls),1)
+ def test_post_timeout_never_retries(self):
+  with Harness('host',[TimeoutError()]) as x:
+   with self.assertRaises(TimeoutError):x.call('POST',b'{}')
+   self.assertEqual(len(x.calls),1);self.assertEqual(x.sleeps,[])
+ def test_post_transient_http_never_retries(self):
+  with Harness('host',[urllib.error.HTTPError(URL,503,'synthetic',{},None)]) as x:
+   with self.assertRaisesRegex(h.Hold,'CLOUD_HTTP_503'):x.call('POST',b'{}')
+   self.assertEqual(len(x.calls),1)
+ def test_get_with_body_and_head_never_retry(self):
+  for method,body in [('GET',b'{}'),('HEAD',None)]:
+   with Harness('host',[ConnectionResetError()]) as x:
+    with self.assertRaises(ConnectionResetError):x.call(method,body)
+    self.assertEqual(len(x.calls),1)
+ def test_cas_collision_and_missing_object_keep_original_semantics(self):
+  for code in (404,412):
+   for method,body in [('GET',None),('POST',b'{}')]:
+    with Harness('host',[urllib.error.HTTPError(URL,code,'synthetic',{},None)]) as x:self.assertEqual(x.call(method,body),(code,b''));self.assertEqual(len(x.calls),1)
+ def test_versioned_body_retry_never_switches_generation(self):
+  with Harness('host',[Response(b'{"generation":"17"}'),TimeoutError(),Response(b'{"x":1}')]) as x:
+   result=x.cloud.read(h.OBJECT);self.assertEqual(result['generation'],'17');self.assertEqual(x.calls[1]['url'],x.calls[2]['url']);self.assertTrue(x.calls[1]['url'].endswith('?alt=media&generation=17'))
+ def test_retry_success_still_rejects_foreign_authority(self):
+  adapter=h.Base.__new__(h.Base);adapter.code=lambda:None;adapter.read_state=lambda:{'generation':'18','sha256':'new','value':{}}
+  with self.assertRaisesRegex(h.Hold,'AUTHORITY_CHANGED'):adapter.fresh({'generation':'17','sha256':'old'})
+ def test_expired_original_contract_still_rejects_before_next_action(self):
+  adapter=h.Base.__new__(h.Base);adapter.code=lambda:None;record={'generation':'17','sha256':'same','value':{}};adapter.read_state=lambda:record;adapter.c={'expiresAt':1000,'recoveryUntil':2000};adapter.job=types.SimpleNamespace(deployment=lambda *a:None);adapter.cloud=types.SimpleNamespace(sole_owner=lambda c:None);adapter.now=lambda:2001
+  for recovery in (False,True):
+   with self.subTest(recovery=recovery),self.assertRaisesRegex(h.Hold,'JOB_DEADLINE'):adapter.fresh(record,recovery)
+if __name__=='__main__':unittest.main()
