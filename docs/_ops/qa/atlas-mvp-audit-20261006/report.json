  "baseline": "docs/_ops/qa/atlas-mvp-20261006/report.json",
  "scope": "Review and fix reproducible local MVP input, authorization, time, request and storage failures; paid AI and tutor excluded.",
  "findings": [
    {
      "area": "Discovery input and clock",
      "fixed": [
        "Use one checked time per preview",
        "Preserve the unsaved answer when changing its scope",
        "Prevent observed expiry from reversing with a device clock correction",
        "Retain explicit unknown when deleting the baseline only",
        "Create new live scenarios at the actual clock, preserving legacy deterministic fixtures and stored log ordering"
      ],
      "evidence": [
        "tests/atlas-discovery.test.mjs",
        "tests/atlas-next-smoke.mjs"
      ]
    },
    {
      "area": "Meeting and invitation permissions",
      "fixed": [
        "Pause cannot be bypassed via edit or next",
        "Withdrawing future meeting consent closes outstanding invitations and gates new sends/responses/preparation",
        "Old invitation acceptance cannot skip the current concrete plan; advancing closes obsolete pending invitations"
      ],
      "compatibility": "Keep completed attendance, private reflection, in-progress completion and old saved invitation IDs.",
      "evidence": [
        "tests/atlas-meeting.test.mjs",
        "tests/atlas-reconnect.test.mjs"
      ]
    },
    {
      "area": "Participant UI and launcher",
      "fixed": [
        "Redact the old projection upon access-denied response even when its follow-up read fails",
        "Retain the explicit message draft after transmission failure; no automatic resend",
        "Align message length to 280 and trim surrounding whitespace before explicit send",
        "Changing the candidate during role preparation does not leave the new action disabled or publish stale links"
      ],
      "evidence": [
        "tests/atlas-participant-ui.test.mjs",
        "tests/atlas-participant-launcher.test.mjs"
      ],
      "method": "Actual UI modules with minimal DOM/deferred HTTP contracts, plus local browser journeys. Access-denied fallback is a client response-boundary regression."
    },
    {
      "area": "Corrupt storage recovery",
      "fixed": [
        "Explicit deletion can discard invalid or old envelopes",
        "v2 deletion epoch prevents old writes even after damaged counters are repaired",
        "Non-JSON IndexedDB payload serialization rejects instead of leaving the operation queue stuck"
      ],
      "compatibility": "Valid v1 remains readable; writes use v2 with revision/generation/epoch CAS. No automatic restoration or opt-in.",
      "evidence": [
        "docs/_ops/qa/atlas-mvp-audit-20261006/memory-recovery-before.json",
        "docs/_ops/qa/atlas-mvp-audit-20261006/memory-recovery-clone-before.json",
        "docs/_ops/qa/atlas-mvp-audit-20261006/memory-recovery-after.json"
      ],
      "method": "Actual Chromium IndexedDB; old-version, malformed counters, valid-v1/CAS and cyclic/BigInt payload paths."
    },
    {
      "area": "Request upload and expiry",
      "fixed": [
        "Recheck the cached pair after upload before returning retry capabilities",
        "Clean expired pairs after upload before applying capacity limits"
      ],
      "evidence": [
        "tests/atlas-journey-host.test.mjs"
      ],
      "additionalChecks": "Sessions expiring or pairs deleted during uploads cannot be mutated; CSRF and request receipts remain role/pair scoped."
    }
  ],
