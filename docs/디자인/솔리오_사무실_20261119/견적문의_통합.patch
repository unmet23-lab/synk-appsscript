+  do{
+    const reply=await client.rpc('mcpServerStatus/list',{...(threadId?{threadId}:{}),detail:'toolsAndAuthOnly',limit:100,...(cursor?{cursor}:{})},
+      threadId?undefined:DISCOVERY_TIMEOUT_MS);
