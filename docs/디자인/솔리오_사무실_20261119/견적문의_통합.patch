+    const mailbox=quoteMailbox(provider),messages=[];
+    for(let index=0;index<30;index++){
+      messages.push(mailbox.add((4096+index).toString(16),'책자 견적 '+(index+1),'책자 30부 인쇄 견적을 부탁드립니다.'));
+    }
