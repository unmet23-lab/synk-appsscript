{
  "type": "object",
  "additionalProperties": false,
  "required": ["notes"],
  "properties": {
    "notes": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "para", "quote", "why", "evidence", "source", "fix"],
        "properties": {
          "kind": { "type": "string", "enum": ["mismatch", "unsupported"] },
          "para": { "type": "integer", "minimum": 1, "maximum": 400 },
          "quote": { "type": "string", "maxLength": 300 },
          "why": { "type": "string", "maxLength": 200 },
          "evidence": { "type": "string", "maxLength": 200 },
          "source": { "type": "integer", "minimum": 0, "maximum": 10 },
          "fix": { "type": "string", "maxLength": 400 }
        }
      }
    }
  }
}
