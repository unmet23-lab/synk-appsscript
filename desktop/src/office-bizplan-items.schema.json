{
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "secs", "thin", "why", "asks"],
        "properties": {
          "item": { "type": "string", "enum": ["문제 인식"] },
          "secs": { "type": "array", "maxItems": 40, "items": { "type": "integer", "minimum": 1, "maximum": 400 } },
          "thin": { "type": "boolean" },
          "why": { "type": "string", "maxLength": 200 },
          "asks": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["q", "opts"],
              "properties": {
                "q": { "type": "string", "maxLength": 200 },
                "opts": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["label", "sentence"],
                    "properties": {
                      "label": { "type": "string", "maxLength": 40 },
                      "sentence": { "type": "string", "maxLength": 300 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
